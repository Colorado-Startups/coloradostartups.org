---
// Every page uses this layout. Orchestrator-owned; lanes pass props, and ask
// for changes. A page that has structured data passes it as `jsonLd`.
import { Font } from "astro:assets";

import HallTextures from "../components/ui/HallTextures.astro";
import SiteFooter from "../components/ui/SiteFooter.astro";
import SiteHeader from "../components/ui/SiteHeader.astro";
import "../styles/global.css";
import { jsonLdText } from "./json-ld";
import tokensYaml from "../../../01_doctrine/brand_tokens.yaml?raw";
import { parse } from "yaml";

interface Props {
  title: string;
  description: string;
  /** Path under /og/ without extension, e.g. "home". L7 names files by route. */
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description, ogImage = "default", noindex = false, jsonLd } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).toString();
const ogUrl = new URL(`/og/${ogImage}.jpg`, site).toString();
// The browser bar takes State Blue in the light theme and the night ground in
// the dark one, both read from the token source (brand_tokens.yaml).
const tokens = parse(tokensYaml) as { color: Record<string, string>; night: Record<string, string> };
const themeLight = tokens.color.text;
const themeDark = tokens.night.ground;
const fullTitle = title === "Colorado Startups" ? title : `${title} | Colorado Startups`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* A noindex page names no canonical, so no page asks to be indexed and dropped at once (GO-LIVE B5). */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    {/* Two Search Console properties verify by these tags, copied from the old home page (curl, 2026-10-18); DNS holds neither (GO-LIVE B9). */}
    <meta name="google-site-verification" content="MasSRxNF93yU-Ejfs2kjL-sEXttLYOLkZV-3CtlkBHY" />
    <meta name="google-site-verification" content="F7Z7mKLCmYVKSVe98UjyfnvYoTKlnuy8snAhkuMUXfQ" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Colorado Startups" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* The page follows the reader's system theme (tokens.css night block); this tells the browser before CSS loads. */}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={themeLight} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={themeDark} />
    {/* Brand v3 icon tier (brand decisions 50 and 54), pulled by scripts/brand/pull.mjs. */}
    <link rel="icon" href="/art/brand/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/art/brand/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/art/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/feed+json" title="Colorado Startups dispatches" href="/feed.json" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="Colorado Startups dispatches" />
    {/* Only the faces the first screen draws: Aileron 700 for h1 and h2, Atkinson Hyperlegible 400 and 700 for text. */}
    <Font cssVariable="--font-display" preload={[{ weight: 700, style: "normal" }]} />
    <Font cssVariable="--font-body" preload={[{ weight: 400, style: "normal" }, { weight: 700, style: "normal" }]} />
    <HallTextures />
    {jsonLd && <script type="application/ld+json" set:html={jsonLdText(jsonLd)} />}
    {/* Cloudflare Web Analytics sets no cookies, as privacy.md promises. The edge's automatic injection did not
        reach the Worker's static assets on launch night, so the beacon is in the page. The token is public by
        design, and the CSP allows both hosts (worker/lib/security-headers.ts, public/_headers). The secret scans'
        allow marker on its line holds wherever the line moves (#767, 04_tools/gitleaks_allow.json); it renders nothing.
        Only a production build carries the tag, so `astro dev` counts no visit, and the test server takes it out of
        every page it sends (scripts/strip-beacon.mjs, #66). */}
    {import.meta.env.PROD && <script is:inline defer data-cs-beacon src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "58c9c5c3a6b843ec87df6970cbbc0d97"}'></script>}{/* gitleaks:allow */}
    {/* The click-event helper (src/lib/track.ts, step M1b). Astro ships it as one external module script, deferred
        by nature, as the CSP's script-src 'self' needs. It sends nothing on its own: only a click on an element
        marked data-track does, and only in a production build on the live host, never under GPC or Do Not Track. */}
    <script>
      import { install } from "../lib/track";

      install();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
