---
// /regions/: the three zones, map first (step H of the 2026-11-15 redesign).
//   1. The big map (ColoradoMap and LiveMaps): a real-map drawing over shaded
//      relief, the whole map without JavaScript. MapLibre loads only when a
//      visitor presses "Explore the live map", so the page's entry script
//      stays small. The chips under it are its legend and list alternative:
//      color, cities and the Connector seat.
//   2. The regions side by side (Tallies, step W6): three sourced tallies per
//      region, in data order, never ranked.
//   3. What each region builds: the home page's three theme panels
//      (ThemePanel and themes()), each headed by its region's map, each figure
//      with its source.
//   4. How the regions work, in captions, and a line for founders elsewhere in
//      Colorado (decision 45).
// Each region's Connector seat is a person's; the keepers, AI agents, never
// take it (decision 43). Owner: L8.
import { WAYS_IN } from "@cs/shared";
import { getCollection } from "astro:content";

import { themes } from "../../components/home/home-data";
import ThemePanel from "../../components/home/ThemePanel.astro";
import ColoradoMap from "../../components/map/ColoradoMap.astro";
import LiveMaps from "../../components/map/LiveMaps.astro";
import RegionChip from "../../components/regions/RegionChip.astro";
import Tallies from "../../components/regions/Tallies.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { REGIONS } from "../../lib/regions/match";
import { organizerFor } from "../../lib/regions/page";
import { joinAttrs } from "../../lib/track-attrs";

const positions = (await getCollection("positions")).map((e) => e.data);
const people = (await getCollection("people")).map((e) => e.data);
// The statewide seat (decision 44), for the line to founders outside the regions.
const statewideSeat = positions.find((p) => p.id === "community-organizer");
---

<BaseLayout
  title="Regions"
  description="Colorado Startups gathers founders in three regions along the Front Range: Photon Mountain, Space Peak and Fusion Canyon."
  ogImage="regions"
>
  <section class="section section--lit" aria-labelledby="regions-title">
    <div class="wrap">
      <p class="kicker">Three regions along the Front Range</p>
      <h1 id="regions-title">Regions</h1>
      <p class="lede">Find your region. Meet the founders building near you.</p>
      <div class="hub">
        <ColoradoMap id="regions-map" where="regions-map" />
        <LiveMaps />
        <div>
          <h2 class="visually-hidden">The three regions</h2>
          <ul class="region-chips" role="list">
            {REGIONS.map((r) => <RegionChip region={r} organizer={organizerFor(r.id, positions, people)} />)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--lit" aria-labelledby="side-by-side">
    <div class="wrap">
      <h2 id="side-by-side">The regions side by side</h2>
      <p class="lede">Three equals, in their fixed order. Each bar compares one tally across the three.</p>
      <Tallies regions={REGIONS} />
    </div>
  </section>

  <section class="section section--band" aria-labelledby="builds">
    <div class="wrap">
      <h2 id="builds">What each region builds</h2>
      <div class="themes">
        {themes().map((theme) => <ThemePanel theme={theme} where="regions-themes" />)}
      </div>
    </div>
  </section>

  <section class="section section--lit" aria-labelledby="how-title">
    <div class="wrap how">
      <div>
        <h2 id="how-title">How the regions work</h2>
        <ul class="how__list" role="list">
          <li><strong>1 Connector</strong> per region. A person, never an AI keeper.</li>
          <li><strong>1 Slack</strong> and <strong>1 event calendar</strong> for all of Colorado.</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--gold" href={WAYS_IN.slack} aria-describedby="slack-note" {...joinAttrs("regions")}>Join the Slack</a>
          <a class="btn btn--stone" href={WAYS_IN.events}>See upcoming events</a>
        </div>
        <p class="meta" id="slack-note">Join the Slack opens a Google Form.</p>
      </div>
      <div class="elsewhere">
        <h2 id="elsewhere">Elsewhere in Colorado</h2>
        <p>
          Building in Durango, Grand Junction, Pueblo or anywhere else in Colorado? You are part of this community too.
          Find help near you in <a href="/ecosystem-canvas/">Startup Resources</a>.
        </p>
        {
          statewideSeat?.status === "open" && (
            <p>
              The statewide community organizer seat is open. <a href="/get-involved/">See every open seat</a>.
            </p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The map takes two thirds of the row, so at 1280 px it stands about 560 px
     tall, inside one screen; the chips beside it are its legend. */
  .hub {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
    margin-top: var(--s-6);
  }
  /* A list gets the reading measure by default (global.css); these are grids. */
  .region-chips,
  .how__list {
    max-width: none;
    padding: 0;
    list-style: none;
  }
  .region-chips {
    display: grid;
    gap: var(--s-4);
    margin: 0;
  }
  .themes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-5);
  }
  .how {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7);
    align-items: start;
  }
  .how__list {
    display: grid;
    gap: var(--s-2);
    margin: var(--s-4) 0 var(--s-5);
  }
  .how__list strong {
    font-family: var(--font-display);
    font-size: var(--t-step-1);
  }
  .how .meta {
    margin: var(--s-3) 0 0;
  }
  @media (max-width: 960px) {
    .themes,
    .hub {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 760px) {
    .how {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
