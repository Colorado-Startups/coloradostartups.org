---
// /regions/<id>/: one zone's hub (step H of the 2026-11-15 redesign), built
// from sections in components/regions/sections/. In order: Hero, with the
// region's real map in the first screen (the drawing zoomed to the zone, the
// other two dimmed; its relief is the page's LCP image) beside what is there
// (WhatsHere: counts, cities, the next event, an open seat, nearby towns and
// size) and four sourced figures; the This week slot; the Connector seat, a
// person's; six Startup Resources and six Leaderboard honorees, each with a
// link to see all of them; the Spotlights slot; the Slack and events; the
// place painting as an extra (Art, step R1: Paul, 2026-11-16, "It should be
// the map and what's there"); the Ask your AI slot; and the other two
// regions. The slots render nothing until their steps fill them. Every city
// goes through regionForCity(), so a city added to the YAML shows up in every
// list (decision 45). The title is the region name alone, no hub word (#67).
// Owner: L8.
import { regionLede, WAYS_IN } from "@cs/shared";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

import { activeCards } from "../../components/canvas/canvas-data";
import ColoradoMap from "../../components/map/ColoradoMap.astro";
import LiveMaps from "../../components/map/LiveMaps.astro";
import OrganizerCard from "../../components/regions/OrganizerCard.astro";
import RegionChip from "../../components/regions/RegionChip.astro";
import RegionHonorees from "../../components/regions/RegionHonorees.astro";
import RegionResources from "../../components/regions/RegionResources.astro";
import Art from "../../components/regions/sections/Art.astro";
import AskAi from "../../components/regions/sections/AskAi.astro";
import Hero from "../../components/regions/sections/Hero.astro";
import Spotlights from "../../components/regions/sections/Spotlights.astro";
import ThisWeek from "../../components/regions/sections/ThisWeek.astro";
import WhatsHere from "../../components/regions/sections/WhatsHere.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildBoard, latestEdition } from "../../lib/leaderboard/board";
import { REGIONS } from "../../lib/regions/match";
import { andList, honoreesIn, inRegion, organizerFor, summaryAfterLede } from "../../lib/regions/page";

// The map draws in the hero's right column, 3 of 5 parts of .wrap (100vw less
// two 24 px gutters, at most 1180 px) less the 48 px gap; under 760 px, the
// whole .wrap. `sizes` cannot read CSS variables, so it uses rem (16 px).
const MAP_SIZES = "(max-width: 47.5rem) calc(100vw - 3rem), (max-width: 76.75rem) calc(60vw - 3.6rem), 42.5rem";

export const getStaticPaths = (async () => {
  const regions = [...REGIONS];
  return regions.map((region) => ({ params: { id: region.id }, props: { region, regions } }));
}) satisfies GetStaticPaths;

const { region, regions } = Astro.props;

const positions = (await getCollection("positions")).map((e) => e.data);
const people = (await getCollection("people")).map((e) => e.data);
const organizer = organizerFor(region.id, positions, people);

const cards = await activeCards();
const regionCards = inRegion(region.id, cards, (c) => c.city, regions);
const statewide = cards.filter((c) => c.city === "statewide").length;

const companies = (await getCollection("companies")).map((e) => e.data);
const edition = latestEdition((await getCollection("editions")).map((e) => e.data));
if (!edition) throw new Error("no Leaderboard edition in data/leaderboard/editions/");
const honorees = honoreesIn(
  region.id,
  buildBoard(edition, companies).map((row) => row.company),
  regions,
);

const others = regions.filter((r) => r.id !== region.id);
---

<BaseLayout title={region.name} description={`${regionLede(region)} Core cities: ${andList(region.cities)}.`} ogImage={region.id}>
  <Hero region={region}>
    <ColoradoMap slot="map" id="region-map" zone={region.id} caption={summaryAfterLede(region)} sizes={MAP_SIZES} priority />
    <WhatsHere slot="here" region={region} />
  </Hero>
  <LiveMaps />
  <ThisWeek region={region} />

  <section class="section section--band" aria-labelledby="organizer">
    <div class="wrap">
      <h2 id="organizer">{organizer.holder ? `Your ${organizer.position.title}` : `The ${organizer.position.title} seat`}</h2>
      <OrganizerCard organizer={organizer} />
    </div>
  </section>

  <section class="section section--lit" aria-labelledby="resources">
    <div class="wrap">
      <h2 id="resources">Startup Resources</h2>
      <RegionResources region={region} cards={regionCards} statewide={statewide} />
    </div>
  </section>

  <section class="section section--band" aria-labelledby="honorees">
    <div class="wrap">
      <h2 id="honorees">Leaderboard honorees</h2>
      <RegionHonorees region={region} edition={edition} companies={honorees} />
    </div>
  </section>

  <Spotlights region={region} />

  <section class="section section--lit" aria-labelledby="meet">
    <div class="wrap">
      <h2 id="meet">Meet founders here</h2>
      <p>
        One Slack and one event calendar for all of Colorado.
        {region.slack_channel && <> {region.name} founders gather in #{region.slack_channel}.</>}
      </p>
      <div class="btn-row">
        <a class="btn btn--gold" href={WAYS_IN.slack} aria-describedby="slack-note">Join the Slack</a>
        <a class="btn btn--stone" href={WAYS_IN.events}>See upcoming events</a>
      </div>
      <p class="meta" id="slack-note">Join the Slack opens a Google Form.</p>
    </div>
  </section>

  <Art region={region} />

  <AskAi region={region} />

  <section class="section section--lit" aria-labelledby="other-regions">
    <div class="wrap">
      <h2 id="other-regions">The other regions</h2>
      <ul class="region-chips others" role="list">
        {others.map((r) => <RegionChip region={r} organizer={organizerFor(r.id, positions, people)} />)}
      </ul>
      <p>
        Building somewhere else in Colorado? <a href="/regions/#elsewhere">You belong here too</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  #slack-note {
    margin: var(--s-3) 0 0;
  }
  /* A list gets the reading measure by default (global.css); these are rows. */
  .region-chips {
    max-width: none;
    padding: 0;
    list-style: none;
  }
  .region-chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
    margin: 0 0 var(--s-5);
  }
  @media (max-width: 760px) {
    .region-chips {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
