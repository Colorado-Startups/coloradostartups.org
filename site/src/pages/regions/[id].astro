---
// /regions/<id>/: one zone's hub (step H of the 2026-11-15 redesign). In order:
// the place painting and four sourced figures (region-tiles.ts); the map
// zoomed to the zone, the other two dimmed, beside its core cities and nearby
// towns; the Connector seat, a person's; six Startup Resources and six
// Leaderboard honorees, each with a link to see all of them; the Slack and
// events; and the other two regions. Every city goes through regionForCity(),
// so a city added to the YAML shows up in both lists (decision 45). Owner: L8.
import { regionLede, WAYS_IN } from "@cs/shared";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

import { activeCards } from "../../components/canvas/canvas-data";
import StatTile from "../../components/home/StatTile.astro";
import ColoradoMap from "../../components/map/ColoradoMap.astro";
import LiveMaps from "../../components/map/LiveMaps.astro";
import OrganizerCard from "../../components/regions/OrganizerCard.astro";
import RegionArt from "../../components/regions/RegionArt.astro";
import RegionChip from "../../components/regions/RegionChip.astro";
import RegionHonorees from "../../components/regions/RegionHonorees.astro";
import RegionResources from "../../components/regions/RegionResources.astro";
import { regionTiles } from "../../components/regions/region-tiles";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildBoard, latestEdition } from "../../lib/leaderboard/board";
import { REGION_COLORS } from "../../lib/regions/map";
import { REGIONS } from "../../lib/regions/match";
import { andList, honoreesIn, inRegion, organizerFor, summaryAfterLede } from "../../lib/regions/page";

export const getStaticPaths = (async () => {
  const regions = [...REGIONS];
  return regions.map((region) => ({ params: { id: region.id }, props: { region, regions } }));
}) satisfies GetStaticPaths;

const { region, regions } = Astro.props;

const positions = (await getCollection("positions")).map((e) => e.data);
const people = (await getCollection("people")).map((e) => e.data);
const organizer = organizerFor(region.id, positions, people);

const cards = await activeCards();
const regionCards = inRegion(region.id, cards, (c) => c.city, regions);
const statewide = cards.filter((c) => c.city === "statewide").length;

const companies = (await getCollection("companies")).map((e) => e.data);
const edition = latestEdition((await getCollection("editions")).map((e) => e.data));
if (!edition) throw new Error("no Leaderboard edition in data/leaderboard/editions/");
const honorees = honoreesIn(
  region.id,
  buildBoard(edition, companies).map((row) => row.company),
  regions,
);

const others = regions.filter((r) => r.id !== region.id);
---

<BaseLayout title={`${region.name} Outpost`} description={`${regionLede(region)} Core cities: ${andList(region.cities)}.`} ogImage={region.id}>
  <section class="section section--lit" aria-labelledby="region-title" style={`--region-color: ${REGION_COLORS[region.id]}`}>
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="crumbs">
        <ol>
          <li><a href="/regions/">Regions</a></li>
          <li aria-current="page">{region.name}</li>
        </ol>
      </nav>
      <h1 id="region-title">{region.name}</h1>
      <p class="lede">{regionLede(region)}</p>
      {/* The page's main action, in the first screen at 375 and 1280 px (#218).
          "Meet founders here" below repeats it. Each Slack button says where
          it goes (#128). */}
      <div class="first-actions">
        <div class="btn-row">
          <a class="btn btn--gold" href={WAYS_IN.slack} aria-describedby="slack-note-top">Join the Slack</a>
          <a class="btn btn--stone" href={WAYS_IN.events}>See upcoming events</a>
        </div>
        <p class="meta" id="slack-note-top">Join the Slack opens a Google Form.</p>
      </div>
      <RegionArt region={region} size="hero" />
      <h2 class="visually-hidden">{region.name} in numbers</h2>
      <div class="tiles" data-region-tiles>
        {regionTiles(region.id).map((t) => <StatTile {...t} />)}
      </div>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="where">
    <div class="wrap where">
      <ColoradoMap id="region-map" zone={region.id} caption={summaryAfterLede(region)} />
      <LiveMaps />
      <div class="where__places">
        <h2 id="where">Where it is</h2>
        <h3>Core cities</h3>
        <ul class="cities" role="list">
          {region.cities.map((city) => <li class="hall-badge">{city}</li>)}
        </ul>
        {
          region.nearby.length > 0 && (
            <>
              <h3>Nearby towns</h3>
              <p class="nearby">{andList(region.nearby)}</p>
            </>
          )
        }
      </div>
    </div>
  </section>

  <section class="section section--lit" aria-labelledby="organizer">
    <div class="wrap">
      <h2 id="organizer">{organizer.holder ? `Your ${organizer.position.title}` : `The ${organizer.position.title} seat`}</h2>
      <OrganizerCard organizer={organizer} />
    </div>
  </section>

  <section class="section section--band" aria-labelledby="resources">
    <div class="wrap">
      <h2 id="resources">Startup Resources</h2>
      <RegionResources region={region} cards={regionCards} statewide={statewide} />
    </div>
  </section>

  <section class="section section--lit" aria-labelledby="honorees">
    <div class="wrap">
      <h2 id="honorees">Leaderboard honorees</h2>
      <RegionHonorees region={region} edition={edition} companies={honorees} />
    </div>
  </section>

  <section class="section section--band" aria-labelledby="meet">
    <div class="wrap">
      <h2 id="meet">Meet founders here</h2>
      <p>
        One Slack and one event calendar for all of Colorado.
        {region.slack_channel && <> {region.name} founders gather in #{region.slack_channel}.</>}
      </p>
      <div class="btn-row">
        <a class="btn btn--gold" href={WAYS_IN.slack} aria-describedby="slack-note">Join the Slack</a>
        <a class="btn btn--stone" href={WAYS_IN.events}>See upcoming events</a>
      </div>
      <p class="meta" id="slack-note">Join the Slack opens a Google Form.</p>
    </div>
  </section>

  <section class="section section--lit" aria-labelledby="other-regions">
    <div class="wrap">
      <h2 id="other-regions">The other regions</h2>
      <ul class="region-chips others" role="list">
        {others.map((r) => <RegionChip region={r} organizer={organizerFor(r.id, positions, people)} />)}
      </ul>
      <p>
        Building somewhere else in Colorado? <a href="/regions/#elsewhere">You belong here too</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* The breadcrumb's look, and its 44 px phone targets, are global.css's
     .crumbs (#682); only the space above the title is this page's. */
  .crumbs ol {
    margin: 0 0 var(--s-3);
  }
  h1 {
    border-bottom: 4px solid var(--region-color);
    display: inline-block;
    padding-bottom: var(--s-1);
  }
  .first-actions {
    margin: var(--s-4) 0 var(--s-6);
  }
  .first-actions .meta,
  #slack-note {
    margin: var(--s-3) 0 0;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--s-7);
    margin-top: var(--s-6);
  }
  .where {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--s-7);
    align-items: start;
  }
  .where__places h2 {
    margin-top: 0;
  }
  .where__places h3 {
    font-size: var(--t-step-0);
    margin: var(--s-5) 0 var(--s-2);
  }
  /* A list gets the reading measure by default (global.css); these are rows. */
  .cities,
  .region-chips {
    max-width: none;
    padding: 0;
    list-style: none;
  }
  .cities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
  }
  .nearby {
    margin: 0;
    color: var(--c-text-dim);
    font-size: var(--t-step--1);
  }
  .region-chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
    margin: 0 0 var(--s-5);
  }
  @media (max-width: 760px) {
    .tiles,
    .where,
    .region-chips {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
