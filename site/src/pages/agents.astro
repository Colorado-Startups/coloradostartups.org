---
// /agents/ (step A6a): Colorado Startups' AI agents in two groups. "On this
// site" holds the keepers, which run here; "In your own AI tool" holds the
// open-source AI agent projects the brand flags for this page. Few words, and
// the words lead (Paul, 2026-11-16: "they're supposed to be getting info").
// Each card shows a small picture beside the name, then what the agent does,
// how to use it, and its disclosure, word for word from its source, as the
// card's last line (.claude/rules/ai-disclosure.md). At 1280 by 800 the first
// screen shows the title, the intro and every keeper's name, job and link; at
// 375 by 812, the first keeper's name and job. lib/agents/agents.ts builds
// both lists from data/team/dwarves.yaml and the pulled brand.json; nothing
// here types a name or a disclosure. Install paths name only Claude and
// OpenCode (01_doctrine/ai_recommend.yaml).
import AgentCard from "../components/agents/AgentCard.astro";
import Button from "../components/ui/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { PROJECT_AGENTS, SITE_AGENTS } from "../lib/agents/agents";
---

<BaseLayout
  title="AI agents"
  description="Colorado Startups' AI agents: the keepers that run on this site, and the open-source AI agent projects you run in your own AI tool, each with its disclosure."
  ogImage="agents"
>
  <section class="section section--band agents-head" aria-labelledby="agents-title">
    <div class="wrap stack">
      <h1 id="agents-title">AI agents</h1>
      <p class="lede">
        Colorado Startups runs AI agents on this site and shares open-source ones for your own AI tool. Each one says it
        is an AI agent.
      </p>
    </div>
  </section>

  <section class="section section--lit agents-first" id="on-this-site" aria-labelledby="on-this-site-title">
    <div class="wrap stack">
      <h2 id="on-this-site-title">On this site</h2>
      <ul class="hall-grid agents-grid" aria-label="On this site" data-group="site">
        {
          SITE_AGENTS.map((agent) => (
            <AgentCard agent={agent}>
              <p data-what>{agent.what}</p>
              <p class="btn-row">
                <Button variant="secondary" href={agent.where.href} data-where>
                  {agent.where.label}
                </Button>
              </p>
              <p class="ai-note" data-disclosure>{agent.disclosure}</p>
            </AgentCard>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--band" id="in-your-ai-tool" aria-labelledby="in-your-ai-tool-title">
    <div class="wrap stack">
      <h2 id="in-your-ai-tool-title">In your own AI tool</h2>
      <ul class="hall-grid agents-grid agents-grid--projects" aria-label="In your own AI tool" data-group="project">
        {
          PROJECT_AGENTS.map((agent) => (
            <AgentCard agent={agent}>
              <p data-what>{agent.what}</p>
              <p class="meta">{agent.note}</p>
              {agent.install.map((path) => (
                <div class="agent-install" data-install={path.app}>
                  <p class="agent-install__app">{path.app}</p>
                  <pre class="agent-install__code"><code>{path.commands.join("\n")}</code></pre>
                  <p class="meta">
                    <a class="tap-target" href={path.steps}>
                      Install steps<span class="visually-hidden"> for {agent.name}</span>
                    </a>
                  </p>
                </div>
              ))}
              <p class="btn-row">
                <Button variant="secondary" href={agent.repoUrl} data-repo>
                  See {agent.name} on GitHub
                </Button>
              </p>
              <p class="ai-note" data-disclosure>{agent.disclosure}</p>
            </AgentCard>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* A shorter title band and a shorter gap above the first group, so every
     keeper's name, job and link fit in the first screen at 1280 by 800. */
  .agents-head {
    padding-block: var(--s-7) var(--s-6);
  }
  .agents-first {
    padding-top: var(--s-6);
  }
  /* Three keepers side by side on a wide screen, one column on a phone. */
  .agents-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  /* The projects' cards hold install commands, so they take wider columns. */
  .agents-grid--projects {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
  }
  .agent-install {
    display: grid;
    gap: var(--s-2);
  }
  .agent-install > * {
    margin: 0;
  }
  .agent-install__app {
    font-weight: 700;
  }
  /* Commands wrap instead of scrolling, so a 375 px screen never overflows. */
  .agent-install__code {
    margin: 0;
    padding: var(--s-3);
    border: var(--line-hair) solid var(--c-border);
    background: var(--c-surface);
    border-radius: var(--r-chisel);
    font-size: var(--t-step--1);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
