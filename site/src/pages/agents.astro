---
// /agents/ (step A6a): Colorado Startups' AI agents in two groups. "On this
// site" holds the keepers, which run here; "In your own AI tool" holds the
// open-source AI agent projects the brand flags for this page. Visual first,
// few words: a picture, the name, one line, where it lives, and its
// disclosure, word for word from its source, beside it
// (.claude/rules/ai-disclosure.md). lib/agents/agents.ts builds both lists
// from data/team/dwarves.yaml and the pulled brand.json; nothing here types a
// name or a disclosure. Install paths name only Claude and OpenCode
// (01_doctrine/ai_recommend.yaml).
import ArtImage from "../components/art/ArtImage.astro";
import Portrait from "../components/art/Portrait.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import Frame from "../components/ui/Frame.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { PROJECT_AGENTS, SITE_AGENTS } from "../lib/agents/agents";
---

<BaseLayout
  title="AI agents"
  description="Colorado Startups' AI agents: the keepers that run on this site, and the open-source AI agent projects you run in your own AI tool, each with its disclosure."
  ogImage="agents"
>
  <section class="section section--band" aria-labelledby="agents-title">
    <div class="wrap stack">
      <h1 id="agents-title">AI agents</h1>
      <p class="lede">
        Colorado Startups runs AI agents on this site and shares open-source ones for your own AI tool. Each one says it
        is an AI agent.
      </p>
    </div>
  </section>

  <section class="section section--lit" id="on-this-site" aria-labelledby="on-this-site-title">
    <div class="wrap stack">
      <h2 id="on-this-site-title">On this site</h2>
      <ul class="hall-grid agents-grid" aria-label="On this site" data-group="site">
        {
          SITE_AGENTS.map((agent, i) => (
            <Card title={agent.name} tone="gilded" mediaInset element="li" data-agent={agent.id}>
              <Frame slot="media" shape="arch" ratio="4 / 5">
                <Portrait
                  id={agent.id}
                  framed
                  alt={agent.alt}
                  sizes="(max-width: 40rem) 80vw, 20rem"
                  loading={i === 0 ? "eager" : "lazy"}
                />
              </Frame>
              <Badge slot="badges">AI agent</Badge>
              <p>{agent.what}</p>
              <p class="ai-note" data-disclosure>{agent.disclosure}</p>
              <Button slot="actions" variant="secondary" href={agent.where.href} data-where>{agent.where.label}</Button>
            </Card>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--band" id="in-your-ai-tool" aria-labelledby="in-your-ai-tool-title">
    <div class="wrap stack">
      <h2 id="in-your-ai-tool-title">In your own AI tool</h2>
      <ul class="hall-grid agents-grid agents-grid--projects" aria-label="In your own AI tool" data-group="project">
        {
          PROJECT_AGENTS.map((agent) => (
            <Card title={agent.name} element="li" data-agent={agent.id}>
              <ArtImage
                slot="media"
                src={agent.card}
                alt={agent.cardAlt}
                aspect="2 / 1"
                sizes="(max-width: 40rem) 92vw, 36rem"
                motion="none"
              />
              <Badge slot="badges">AI agent</Badge>
              <Badge slot="badges">Open source</Badge>
              <p>{agent.what}</p>
              <p class="meta">{agent.note}</p>
              {agent.install.map((path) => (
                <div class="agent-install" data-install={path.app}>
                  <p class="agent-install__app">{path.app}</p>
                  <pre class="agent-install__code"><code>{path.commands.join("\n")}</code></pre>
                  <p class="meta">
                    <a class="tap-target" href={path.steps}>
                      Install steps<span class="visually-hidden"> for {agent.name}</span>
                    </a>
                  </p>
                </div>
              ))}
              <p class="ai-note" data-disclosure>{agent.disclosure}</p>
              <Button slot="actions" variant="secondary" href={agent.repoUrl} data-repo>
                See {agent.name} on GitHub
              </Button>
            </Card>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* Three keepers side by side on a wide screen, one column on a phone. */
  .agents-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  /* The projects' cards are 2:1 social cards; Card crops its media to
     --card-ratio, so it takes the card's own ratio and keeps the name whole. */
  .agents-grid--projects {
    --card-ratio: 2 / 1;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
  }
  .agent-install {
    display: grid;
    gap: var(--s-2);
  }
  .agent-install > * {
    margin: 0;
  }
  .agent-install__app {
    font-weight: 700;
  }
  /* Commands wrap instead of scrolling, so a 375 px screen never overflows. */
  .agent-install__code {
    margin: 0;
    padding: var(--s-3);
    border: var(--line-hair) solid var(--c-border);
    background: var(--c-surface);
    border-radius: var(--r-chisel);
    font-size: var(--t-step--1);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
