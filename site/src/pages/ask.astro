---
// /ask/: one page to find anything on the site. Pagefind's Component UI
// searches every page, filtered by the type each page tags (type:Resources,
// Companies, Guides, Events). Then the Resourcus box, then a link to
// /connect/, which connects an AI client to the keyless /mcp server
// (worker/mcp/). #connect stays: the worker sends a browser that opens /mcp
// here. Pagefind indexes dist/ after the build, so the search is empty in
// `astro dev`.
import ResourcusPanel from "../components/resourcus/ResourcusPanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Ask"
  description="Search Colorado Startups, ask Resourcus, an AI agent, or connect your AI app to the site's free MCP server."
>
  <section class="section section--band" aria-labelledby="ask-title" data-pagefind-ignore>
    <div class="wrap stack">
      <h1 id="ask-title">Ask</h1>
      <p class="lede">Search the whole site, or filter by type.</p>
      {/* Pagefind's own files, written to dist/pagefind/ by the build. */}
      <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
      <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
      <div class="ask-search" data-ask-search>
        <pagefind-config></pagefind-config>
        <pagefind-input placeholder="Search resources, companies, guides and events"></pagefind-input>
        <pagefind-filter-dropdown filter="type" label="Type"></pagefind-filter-dropdown>
        <pagefind-summary></pagefind-summary>
        <pagefind-results></pagefind-results>
      </div>
    </div>
  </section>

  <section class="section section--lit" aria-label="Ask Resourcus" data-pagefind-ignore>
    <div class="wrap">
      <ResourcusPanel heading="Ask Resourcus" />
    </div>
  </section>

  <section class="section section--lit" id="connect" aria-labelledby="connect-title" data-pagefind-ignore>
    <div class="wrap stack">
      <h2 id="connect-title">Connect your AI</h2>
      <p>Seven AI apps, free, no key. <a href="/connect/">See how to connect yours</a>.</p>
    </div>
  </section>
</BaseLayout>

<script>
  // A search from another page (the home page's Ask box) arrives as ?q=.
  // Put the words in Pagefind's box and fire an input event, so it searches.
  // Pagefind draws its box after the page loads, so look for it a few times.
  const q = new URLSearchParams(location.search).get("q")?.trim();
  if (q) {
    void customElements.whenDefined("pagefind-input").then(() => {
      const fill = (tries: number) => {
        const host = document.querySelector("[data-ask-search] pagefind-input");
        const input = host?.querySelector("input") ?? host?.shadowRoot?.querySelector("input");
        if (input) {
          input.value = q;
          input.dispatchEvent(new Event("input", { bubbles: true }));
        } else if (tries > 0) setTimeout(() => fill(tries - 1), 100);
      };
      fill(30);
    });
  }
</script>

<style>
  .ask-search {
    --pf-text: var(--c-text);
    --pf-text-secondary: var(--c-text-dim);
    --pf-text-muted: var(--c-text-dim);
    --pf-background: var(--c-surface);
    --pf-border: var(--c-rule);
    --pf-font: inherit;
    display: grid;
    gap: var(--s-3);
  }
</style>
