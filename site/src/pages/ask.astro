---
// /ask/: one page to find anything on the site. Pagefind's Component UI
// searches every page, filtered by the type each page tags (type:Resources,
// Companies, Guides, Events). Then the Resourcus box, then two cards that
// connect an AI client to the keyless /mcp server (worker/mcp/).
//
// Connect steps re-read 2026-11-15: Claude's "Get started with custom
// connectors using remote MCP" (support.claude.com) and OpenCode's MCP servers
// page (opencode.ai/docs/mcp-servers). Pagefind indexes dist/ after the build,
// so the search is empty in `astro dev`.
import ResourcusPanel from "../components/resourcus/ResourcusPanel.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const mcpUrl = new URL("/mcp", Astro.site!).toString();
const openCode = JSON.stringify(
  {
    $schema: "https://opencode.ai/config.json",
    mcp: { servers: { coloradostartups: { type: "remote", url: mcpUrl, oauth: false } } },
  },
  null,
  2,
);
---

<BaseLayout
  title="Ask"
  description="Search Colorado Startups, ask Resourcus, or connect Claude or OpenCode to the site's free MCP server."
>
  <section class="section section--band" aria-labelledby="ask-title" data-pagefind-ignore>
    <div class="wrap stack">
      <h1 id="ask-title">Ask</h1>
      <p class="lede">Search the whole site, or filter by type.</p>
      {/* Pagefind's own files, written to dist/pagefind/ by the build. */}
      <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
      <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
      <div class="ask-search" data-ask-search>
        <pagefind-config></pagefind-config>
        <pagefind-input placeholder="Search resources, companies, guides and events"></pagefind-input>
        <pagefind-filter-dropdown filter="type" label="Type"></pagefind-filter-dropdown>
        <pagefind-summary></pagefind-summary>
        <pagefind-results></pagefind-results>
      </div>
    </div>
  </section>

  <section class="section section--lit" aria-label="Ask Resourcus" data-pagefind-ignore>
    <div class="wrap">
      <ResourcusPanel heading="Ask Resourcus" />
    </div>
  </section>

  <section class="section section--lit" id="connect" aria-labelledby="connect-title" data-pagefind-ignore>
    <div class="wrap stack">
      <h2 id="connect-title">Connect your AI</h2>
      <p>Free, read-only, no key.</p>
      <div class="connect-cards">
        <article class="panel stack connect-card" data-connect="claude">
          <h3>Claude</h3>
          <ol>
            <li>Customize › Connectors › + Add › Add custom connector</li>
            <li>Paste the URL, then Continue</li>
            <li>Authentication: No sign in, then Add</li>
          </ol>
          <pre class="connect-code"><code data-copy-source>{mcpUrl}</code></pre>
          <button type="button" class="btn" data-copy>Copy URL</button>
        </article>
        <article class="panel stack connect-card" data-connect="opencode">
          <h3>OpenCode</h3>
          <p>Add to <code>opencode.jsonc</code>:</p>
          <pre class="connect-code"><code data-copy-source>{openCode}</code></pre>
          <button type="button" class="btn" data-copy>Copy config</button>
        </article>
      </div>
      <p class="meta"><a href="/data/">The open data</a> behind it is free under CC BY 4.0.</p>
    </div>
  </section>
</BaseLayout>

<script>
  // Each copy button copies the code block in its own card.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const label = button.textContent ?? "";
    button.addEventListener("click", async () => {
      const text = button.closest("article")?.querySelector("[data-copy-source]")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy it";
      }
      setTimeout(() => (button.textContent = label), 2000);
    });
  }
</script>

<style>
  .ask-search {
    --pf-text: var(--c-text);
    --pf-text-secondary: var(--c-text-dim);
    --pf-text-muted: var(--c-text-dim);
    --pf-background: var(--c-surface);
    --pf-border: var(--c-rule);
    --pf-font: inherit;
    display: grid;
    gap: var(--s-3);
  }
  .connect-cards {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }
  .connect-card ol {
    margin: 0;
    padding-left: var(--s-4);
  }
  .connect-code {
    margin: 0;
    padding: var(--s-3);
    overflow-x: auto;
    border: var(--line-hair) solid var(--c-border);
    background: var(--c-surface);
    border-radius: var(--r-chisel);
    font-size: var(--t-step--1);
  }
</style>
