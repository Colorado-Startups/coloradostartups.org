---
// Home. A first-time visitor's Colorado, in the order Paul set on 2026-11-15
// and signed off as a mockup. Each band is one file in
// components/home/sections/; the ones marked "slot" render nothing yet, and
// the engagement plan step named in each file fills it.
//
// | Band | File | Filled by |
// | --- | --- | --- |
// | Join | Hero | today |
// | Builders | Builders | P1 |
// | Founder spotlights | Spotlights (slot) | P3b |
// | This week | ThisWeek (components/events/ThisWeek.astro) | P2a |
// | Where | Where | today |
// | Why Colorado | Why | today |
// | Pick your door | PickDoor | P4 |
// | Explore | Explore | today |
// | Ask | Ask | today |
// | First steps | FirstSteps (slot) | W5 |
// | Keepers | Keepers | today |
//
// At most 60 visible words a band and 450 a page, a source under every figure,
// no member count, and 75 KB of gzipped JavaScript up front:
// site/test/dom/home/home-budget.test.ts.
// The Leaderboard is never tied to investing (decision 17).
import { DESCRIPTOR, homeJsonLd } from "../components/hall/org";
import Ask from "../components/home/sections/Ask.astro";
import Builders from "../components/home/sections/Builders.astro";
import Explore from "../components/home/sections/Explore.astro";
import FirstSteps from "../components/home/sections/FirstSteps.astro";
import Hero from "../components/home/sections/Hero.astro";
import Keepers from "../components/home/sections/Keepers.astro";
import PickDoor from "../components/home/sections/PickDoor.astro";
import Spotlights from "../components/home/sections/Spotlights.astro";
import ThisWeek from "../components/home/sections/ThisWeek.astro";
import Where from "../components/home/sections/Where.astro";
import Why from "../components/home/sections/Why.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const site = Astro.site!;
const description = `${DESCRIPTOR} Join the Slack and the LinkedIn Group, see Colorado's three startup regions, and find resources.`;
---

<BaseLayout title="Colorado Startups" description={description} ogImage="home" jsonLd={homeJsonLd(site)}>
  <Hero />
  <Builders />
  <Spotlights />
  <ThisWeek />
  <Where />
  <Why />
  <PickDoor />
  <Explore />
  <Ask />
  <FirstSteps />
  <Keepers />
</BaseLayout>
