---
// /event-calendar/: the community's Google Calendar, Luma, and a warm pointer
// to the Startup Community Project for Hikes and Ski Days (PLAN, Pages and
// URLs). The path stays because it is in email signatures. Old Squarespace
// event paths 301 here (public/_redirects). Owner: L13. The next-events cards
// and their Event JSON-LD are L24's (components/events/), built from
// data/events/upcoming.json so crawlers can read what the iframe hides. The
// redesign (2026-11-15): no intro, the next six events as cards. Step L2a
// (2026-11-16) adds every upcoming event as a filterable list
// (components/events/EventList.astro), puts the Google Calendar behind a
// "Full calendar" disclosure so its iframe loads only when opened, and adds
// the Ask your AI row.
import AskAi from "../components/ai/AskAi.astro";
import ArtImage from "../components/art/ArtImage.astro";
import { PLACE_ART_ALT } from "../components/art/keepers";
import { eventsJsonLd, NEXT_COUNT, SNAPSHOT, upcomingEvents } from "../components/events/events";
import EventList from "../components/events/EventList.astro";
import NextEvents from "../components/events/NextEvents.astro";
import CalendarEmbed from "../components/info/CalendarEmbed.astro";
import InfoHeader from "../components/info/InfoHeader.astro";
import { calendarSubscribeUrl, CONTACT_EMAIL, LUMA_CS, LUMA_SCP, mailto } from "../components/info/links";
import BaseLayout from "../layouts/BaseLayout.astro";

const events = upcomingEvents(SNAPSHOT, new Date());
---

<BaseLayout
  title="Event calendar"
  description="Startup events across Colorado in one calendar, plus Colorado Startups events on Luma and where to find Startup Hikes and Startup Ski Days."
  jsonLd={eventsJsonLd(events.slice(0, NEXT_COUNT))}
>
  {/* The /ask/ search filters by this type (Pagefind). */}
  <span data-pagefind-filter="type:Events"></span>
  <section class="section section--lit" aria-labelledby="page-title">
    <div class="wrap">
      <div class="cal-head">
        <InfoHeader kicker="Gatherings across Colorado" title="Event calendar">
          {/* The page's two main actions in the first screen (#225, #723). */}
          <div class="btn-row hero-actions">
            <a class="btn btn--gold" href={LUMA_CS}>See our events on Luma</a>
            <a class="btn btn--stone" href={calendarSubscribeUrl()}>Add to Google Calendar</a>
          </div>
        </InfoHeader>
        <ArtImage
          src="brand/denver"
          alt={PLACE_ART_ALT.denver}
          aspect="21 / 9"
          widths={[640, 960, 1280]}
          sizes="(min-width: 60rem) 26rem, 100vw"
          loading="eager"
          class="cal-art"
        />
      </div>
      <NextEvents events={events} />
      <EventList events={events} />
      <h2 id="full-calendar">The full calendar</h2>
      {/* Google's frame and its cookies load only for a visitor who opens the
          disclosure (CalendarEmbed's deferred mode). The "Full calendar" link
          on the cards (#full-calendar) opens it. */}
      <details class="full-cal" data-full-calendar data-open-on="full-calendar">
        <summary>Full calendar</summary>
        <CalendarEmbed deferred />
      </details>
      <div class="ask-row">
        <AskAi
          subject="Startup events in Colorado"
          path="/event-calendar/"
          question="Which upcoming startup events in Colorado fit me, and which should I go to first?"
        />
      </div>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="more-ways">
    <div class="wrap">
      <h2 id="more-ways">More ways to find events</h2>
      <div class="cards">
        <article class="panel">
          <h3>Colorado Startups on Luma</h3>
          <p>We post the events we host on Luma, where you can RSVP and get reminders.</p>
          <a class="btn btn--gold" href={LUMA_CS}>See our events on Luma</a>
        </article>
        <article class="panel">
          <h3>Add the calendar to yours</h3>
          <p>This link opens Google Calendar and asks to add our calendar to your own. It needs a Google account.</p>
          <a class="btn btn--stone" href={calendarSubscribeUrl()}>Add to Google Calendar</a>
        </article>
        <article class="panel" id="hikes-and-ski-days">
          <h3>Startup Hikes and Startup Ski Days</h3>
          <p>
            Micah Mador and Lindsey Rohde led Colorado Startups as co-Executive Directors and did an incredible job.
            They now run Startup Hikes, Startup Ski Days, Welcome to Boulder and Welcome to Denver through their
            Startup Community Project.
          </p>
          <a class="btn btn--stone" href={LUMA_SCP}>See Startup Community Project events</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--lit" aria-labelledby="add-your-event">
    <div class="wrap">
      <h2 id="add-your-event">Add your event</h2>
      <p>
        Hosting a startup event in Colorado? Email the details to{" "}
        <a href={mailto("Event for the Colorado Startups calendar")}>{CONTACT_EMAIL}</a>.
      </p>
      <p>Include these, and we will review it for the calendar:</p>
      <ul>
        <li>The event's name, date and time</li>
        <li>Where it happens, or that it is online</li>
        <li>A short description and the RSVP link</li>
        <li>Who is organizing it</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .full-cal > summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-tap);
    padding: 0 var(--s-4);
    margin-bottom: var(--s-4);
    border: var(--line-hair) solid var(--c-border);
    border-radius: var(--r-bevel);
    background: var(--c-surface);
    gap: var(--s-2);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .full-cal > summary::-webkit-details-marker {
    display: none;
  }
  /* A triangle that points down once the calendar is open. */
  .full-cal > summary::before {
    content: "";
    border-block: 0.35em solid transparent;
    border-inline-start: 0.55em solid currentColor;
    transition: rotate 0.15s ease;
  }
  .full-cal[open] > summary::before {
    rotate: 90deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .full-cal > summary::before {
      transition: none;
    }
  }
  .full-cal > summary:focus-visible {
    outline: var(--line-bold) solid var(--focus-ring, var(--c-focus));
    outline-offset: var(--line-edge);
  }
  .ask-row {
    margin-top: var(--s-7);
  }
  .hero-actions {
    margin-top: var(--s-4);
  }
  /* The home hero, cropped to its tables and hearth. A strip under the lede on
     phones; beside the header, in the space the lede leaves, from 60rem. */
  .cal-head :global(.cal-art) {
    margin-bottom: var(--s-6);
    border-radius: var(--r-card);
    box-shadow: var(--sh-edge);
  }
  .cal-head :global(.cal-art img) {
    object-position: 72% 85%;
  }
  @media (min-width: 60rem) {
    .cal-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 26rem;
      gap: var(--s-6);
      align-items: center;
    }
    .cal-head :global(.cal-art) {
      aspect-ratio: 8 / 5;
    }
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--s-5);
  }
  .cards .panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .cards .btn {
    margin-top: auto;
  }
</style>
