---
// Review-only page: the Hall's tokens and primitives in one place. noindex and
// excluded from the sitemap. Owned by L12 (the Hall look). The sections live
// in components/styleguide/, and their look in styleguide.css there.
import Foundations from "../components/styleguide/Foundations.astro";
import Primitives from "../components/styleguide/Primitives.astro";
import ColoradoMap from "../components/map/ColoradoMap.astro";
import Rooms from "../components/styleguide/Rooms.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../components/styleguide/styleguide.css";
---

<BaseLayout title="Style guide" description="Tokens and components for the site." noindex>
  <Foundations />
  <Primitives />
  <Rooms />
  <section class="section section--lit" aria-labelledby="map">
    <div class="wrap stack">
      <h2 id="map">Map</h2>
      <p>The statewide map: the drawing shows first, and the live map loads over it near the screen.</p>
      <ColoradoMap id="sg-colorado-map" />
    </div>
  </section>
</BaseLayout>
