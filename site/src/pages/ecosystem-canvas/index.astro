---
// /ecosystem-canvas/: Startup Resources, the directory built on the Ecosystem
// Canvas. Owner: L3. Decision 46 retitled the page; the URL, the anchors and
// the dataset's name (the Ecosystem Canvas) stay.
//
// One job: find a resource. The page opens on up to 12 picks, not 501 rows
// (step L1b, 2026-11-16): the title, one line, the search box and
// Resourcus's "Ask a question instead" disclosure (40 words or fewer), then
// "Start here", up to 3 picks a stage from topPicks() (StartHere.astro).
// Typing a search opens the full list and sets the picks aside. Under the
// picks, "Show all N resources" opens the full list with its chips. The stage chips
// are the journey, Idea to Launch to Growth with Support alongside, each with
// its count. The rows go by stage, A to Z within each substage: the island
// shows the first 24 matches and a "Show more" button, and every row stays in
// the HTML for crawlers. Without JavaScript the full list simply shows below
// the picks. A URL with a filter, a search or an anchor into the list opens
// on the list. The credit to Founder Institute, the links to the guides and
// the "Ask your AI" row close the page.
//
// Anchors other lanes rely on: each stage section is id="idea", "launch",
// "growth" or "support" (decision 33; Communitas's welcome desk links there,
// and the island chooses that stage). Each resource heading is
// id="r-<resource id>", which Pagefind indexes as a sub-result and Resourcus
// and the guides link to; the island shows that row even past the first
// page. The "r-" prefix keeps a resource id from colliding with a stage anchor.
import AskAi from "../../components/ai/AskAi.astro";
import CanvasFilters from "../../components/canvas/CanvasFilters.astro";
import CanvasSearch from "../../components/canvas/CanvasSearch.astro";
import { activeCards, groupByStage } from "../../components/canvas/canvas-data";
import { groupCountText, moreText, PAGE_SIZE, shownText } from "../../components/canvas/filter-logic";
import { showAllText, STAGE_LABELS, STAGE_SUMMARIES } from "../../components/canvas/labels";
import ResourceRow from "../../components/canvas/ResourceRow.astro";
import StartHere from "../../components/canvas/StartHere.astro";
import ResourcusPanel from "../../components/resourcus/ResourcusPanel.astro";
import Badge from "../../components/ui/Badge.astro";
import Button from "../../components/ui/Button.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const cards = await activeCards();
const groups = groupByStage(cards);
---

<BaseLayout
  title="Startup Resources"
  description="Startup Resources: the Colorado programs, events, investors, service providers and support a founder needs, from a first idea to growth."
  ogImage="ecosystem-canvas"
>
  {/* The /ask/ search filters by this type (Pagefind). */}
  <span data-pagefind-filter="type:Resources"></span>
  <div data-canvas-root>
    <section class="section section--band canvas-top" aria-labelledby="canvas-title">
      <div class="wrap stack">
        <h1 id="canvas-title">Startup Resources</h1>
        <p class="canvas-intro">Programs, events, investors and support for Colorado founders, from a first idea to growth.</p>
        <div data-pagefind-ignore><CanvasSearch /></div>
        <details class="canvas-ask" data-canvas-ask data-pagefind-ignore>
          <summary>Ask a question instead</summary>
          {/* The panel's own heading is an h3; this keeps the outline whole. */}
          <h2 class="visually-hidden">Ask a question</h2>
          <ResourcusPanel heading="Ask Resourcus" />
        </details>
      </div>
    </section>

    <StartHere cards={cards} />

    <div class="section section--lit canvas-results">
      <div class="wrap">
        <p class="canvas-show" data-canvas-show-row data-pagefind-ignore>
          <Button aria-expanded="false" aria-controls="all-resources" data-canvas-show-all>
            {showAllText(cards.length)}
          </Button>
        </p>
        <div class="canvas-full" id="all-resources" data-canvas-full hidden>
          <div class="stack canvas-find" data-pagefind-ignore>
            <h2 id="find-title" tabindex="-1">Find a resource</h2>
            <CanvasFilters cards={cards} />
          </div>
          {
            groups.map((g) => (
              <section class="canvas-stage" id={g.stage} aria-labelledby={`${g.stage}-title`} data-canvas-group>
                <div class="canvas-stage__head">
                  <h2 id={`${g.stage}-title`}>{STAGE_LABELS[g.stage]}</h2>
                  <Badge data-group-count data-pagefind-ignore>
                    {groupCountText(g.total)}
                  </Badge>
                </div>
                <p class="meta">{STAGE_SUMMARIES[g.stage]}</p>
                <ul class="canvas-rows">
                  {g.substages
                    .flatMap((s) => s.cards)
                    .map((card) => (
                      <ResourceRow card={card} />
                    ))}
                </ul>
              </section>
            ))
          }
          <div class="canvas-more" data-canvas-more-row data-pagefind-ignore hidden>
            <p class="meta" data-canvas-shown>{shownText(Math.min(PAGE_SIZE, cards.length), cards.length)}</p>
            <button class="btn btn--gold" type="button" data-canvas-more>{moreText(cards.length - PAGE_SIZE)}</button>
          </div>
          <p class="canvas-back" data-canvas-back data-pagefind-ignore hidden>
            <Button variant="quiet" href="#find-title">Back to filters</Button>
          </p>
        </div>
      </div>
    </div>
    {/* Without JavaScript the "Show all" button could do nothing, so it goes
        and the full list simply shows below the picks. */}
    <noscript>
      <style is:inline>
        .canvas-full[hidden] {
          display: block !important;
        }
        .canvas-show {
          display: none !important;
        }
      </style>
    </noscript>

    <section class="section section--band" aria-labelledby="missing-title">
      <div class="wrap stack">
        <h2 id="missing-title">Missing something?</h2>
        <p>A person reviews every suggestion before it goes in.</p>
        <p class="btn-row">
          <a class="btn btn--gold" href="/ecosystem-canvas/suggest/">Suggest a resource</a>
        </p>
        <ul class="canvas-also">
          <li><a href="/guides/">Guides for founders</a>: short answers drawn from this directory.</li>
          <li><a href="/guides/startup-credits/">Startup credits</a>: cloud and AI credits, by stage.</li>
        </ul>
        <p class="meta">
          Startup Resources is built on the Ecosystem Canvas, created by <a href="https://fi.co/">Founder Institute</a> and
          Colorado Startups. The community keeps it current.
        </p>
      </div>
    </section>

    <section class="section section--band" aria-labelledby="ask-ai" data-pagefind-ignore>
      <div class="wrap">
        <AskAi
          subject="Startup Resources"
          path="/ecosystem-canvas/"
          question="Which Colorado programs, events and organizations fit a founder at my stage, and where should I start?"
        />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* The first screen holds the title, the search and the chips, so the band
     is shorter than the site's other sections. */
  .canvas-top {
    padding-block: var(--s-6) var(--s-5);
  }
  .canvas-intro {
    max-width: var(--t-measure);
  }
  .canvas-results {
    padding-block: var(--s-5) var(--s-7);
  }
  .canvas-show {
    margin: 0;
  }
  .canvas-find {
    margin-bottom: var(--s-6);
  }
  .canvas-find h2 {
    margin: 0;
  }
  .canvas-stage + .canvas-stage {
    margin-top: var(--s-7);
  }
  .canvas-stage__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
  }
  .canvas-stage__head h2 {
    margin: 0;
  }
  .canvas-stage > .meta {
    margin: var(--s-1) 0 var(--s-3);
  }
  /* Two columns of rows at 1280, one on a phone. */
  .canvas-rows {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr));
    column-gap: var(--s-6);
    max-width: none;
    margin: 0;
    padding: 0;
  }
  .canvas-more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    margin-top: var(--s-5);
  }
  /* Hidden until the island finds more matches than it shows; display: flex
     above would otherwise outrank the browser's own [hidden] rule. */
  .canvas-more[hidden] {
    display: none;
  }
  .canvas-more p {
    margin: 0;
  }
  .canvas-back {
    margin-top: var(--s-5);
  }
  .canvas-also {
    padding-left: var(--s-5);
  }
  /* The disclosure that holds Resourcus. Its summary is a 44 px tap target,
     and a flex summary drops the native triangle, so a chevron turns in its
     place, as on the region pages (RegionResources.astro). */
  .canvas-ask summary {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--size-tap);
    font-weight: 700;
    color: var(--ink-link, var(--c-link));
    cursor: pointer;
    list-style: none;
  }
  .canvas-ask summary::-webkit-details-marker {
    display: none;
  }
  .canvas-ask summary::before {
    content: "";
    width: 0.5em;
    height: 0.5em;
    border-right: var(--line-edge) solid currentColor;
    border-bottom: var(--line-edge) solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
  }
  .canvas-ask[open] summary::before {
    transform: rotate(45deg);
  }
  .canvas-ask summary:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .canvas-ask[open] summary {
    margin-bottom: var(--s-3);
  }
</style>
