---
// /founders/: the private, founders-only forum (decision 49). Owner: L1.
// WAYS_IN.discourse points here (L10). The forum does not exist yet, so its
// copy speaks of it in the future tense.
//
// The site is live and the forum opens later. This page explains it, who it
// is for, and holds the forum's waitlist (step F1, Paul's decision of
// 2026-11-15: waitlist now, forum platform later). It names no date. The
// waitlist form posts to /api/waitlist, which keeps first and last name,
// email, company name, and optionally the company's website and stage, in
// D1 for up to 365 days (worker/routes/waitlist.ts, data/legal/privacy.md).
// Joining it is not admission: we check that people are founders when the
// forum opens. The first screen's action is "Join the waitlist", a link to
// the form (#218); "Join the Slack" sits beside it as the second action,
// with its note.
//
// The words lead (Paul, 2026-11-16: "they're supposed to be getting info"):
// the first section holds no picture, so the checklist rises into the first
// screen and the lede is the LCP. L6's founders scene (#212, #713; no keeper
// in it) closes the page under the waitlist, lazily, at most 40rem wide.
import { WAYS_IN } from "@cs/shared";

import ArtImage from "../../components/art/ArtImage.astro";
import WaitlistForm from "../../components/founders/WaitlistForm.astro";
import { WAITLIST_ANCHOR } from "../../components/founders/waitlist-fields";
import Button from "../../components/ui/Button.astro";
import Callout from "../../components/ui/Callout.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Founders forum"
  description="A private, founders-only forum for people building companies in Colorado. It opens later."
  ogImage="founders"
>
  <section class="section section--lit hero" aria-labelledby="founders-title">
    <div class="wrap">
      <p class="kicker">Coming later</p>
      <h1 id="founders-title">The founders forum</h1>
      <p class="lede">
        A private forum for founders building companies in Colorado. It opens later.
      </p>
      <div class="btn-row">
        <Button href={`#${WAITLIST_ANCHOR}`}>Join the waitlist</Button>
        <Button variant="secondary" href={WAYS_IN.slack} aria-describedby="slack-form-note-top">Join the Slack</Button>
      </div>
      <p class="meta" id="slack-form-note-top">Join the Slack opens a Google Form.</p>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="who">
    <div class="wrap grid">
      <div>
        <h2 id="who">Who it is for</h2>
        <ul class="checklist" role="list">
          {
            ["Founder or cofounder", "Building a company in Colorado", "Any stage, from first idea to growth"].map(
              (line) => (
                <li>
                  <span class="checklist__mark" aria-hidden="true">
                    ✓
                  </span>
                  <span>{line}</span>
                </li>
              ),
            )
          }
        </ul>
        <p>
          The forum is for founders only. Talent, investors, lenders and service providers are welcome in the Slack
          and the LinkedIn Group.
        </p>
      </div>
      <div>
        <h2 id="what">What it is for</h2>
        <ul class="uses">
          <li>Ask other founders the questions you would not post in public.</li>
          <li>Share what worked, and what did not.</li>
          <li>Find founders a stage ahead of you.</li>
        </ul>
        <Callout>
          <p>
            It will run on Discourse, open-source forum software. People will moderate it, as they do every Colorado
            Startups space.
          </p>
        </Callout>
      </div>
    </div>
  </section>

  <section class="section section--lit" id={WAITLIST_ANCHOR} aria-labelledby="waitlist-title">
    <div class="wrap stack">
      <h2 id="waitlist-title">Join the waitlist</h2>
      <p>
        Joining the waitlist is not admission. When the forum opens, we check that each person on it is a founder.
        We use your details only to email you then and to make that check. We never sell or share them.{" "}
        <a href="/privacy/">Read the privacy policy</a>.
      </p>
      <WaitlistForm />
      <p>We will also announce the opening in the Slack and the Startupers newsletter.</p>
      <div class="btn-row">
        <Button variant="secondary" href={WAYS_IN.newsletter}>Get the newsletter</Button>
      </div>
      <ArtImage
        src="brand/founders"
        alt="Founders build a glowing fusion core in a brass ring at a workbench in a red sandstone workshop, with the Flatirons through the window."
        aspect="16 / 9"
        widths={[640, 720, 960, 1280]}
        sizes="(min-width: 44rem) 40rem, calc(100vw - 48px)"
        loading="lazy"
        class="founders-art"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* The note under the Slack button says where it goes (#128). */
  #slack-form-note-top {
    margin: var(--s-3) 0 0;
  }
  .hero {
    background:
      radial-gradient(90% 80% at 50% 0%, color-mix(in oklab, var(--c-accent) 26%, transparent), transparent 70%),
      var(--c-ground);
  }
  /* The founders scene closes the page, at most 40rem wide. ArtImage renders
     the figure in its own scope, so this reaches it by class. */
  #waitlist :global(.founders-art) {
    width: min(100%, 40rem);
    margin-top: var(--s-6);
    border-radius: var(--r-card);
    box-shadow: var(--sh-glow);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7);
  }
  .uses li + li {
    margin-top: var(--s-2);
  }
  /* Who it is for: a list to scan, each line with a check mark. The mark is
     decoration, so assistive tech reads only the words. */
  .checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s-4);
    display: grid;
    gap: var(--s-2);
  }
  .checklist li {
    display: grid;
    grid-template-columns: 1.5em 1fr;
    align-items: baseline;
    font-weight: 700;
  }
  .checklist__mark {
    color: var(--c-pine);
  }
  /* Room above the form when the first screen's button jumps to it. */
  #waitlist {
    scroll-margin-top: var(--s-7);
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
  }
</style>
