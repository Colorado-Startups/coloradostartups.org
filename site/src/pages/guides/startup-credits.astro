---
// /guides/startup-credits/: cloud, GPU and AI credit programs, grouped by what
// each one asks of a founder (session S7, decisions 78 to 81). lib/guides/
// credits.ts parses the dated snapshot in data/credits/ and groups it, and
// lib/guides/credits-chart.ts draws the chart; this page renders them. A
// static route, so it wins over guides/[slug].astro, which builds only the
// Startup Resources guides.
//
// Step F of the redesign (2026-11-15): the answer, then a bar chart of the
// largest credit each provider states, then the three groups as tiles, then
// the tables. Each row shows the program, its amount and what it covers; what
// it needs and its terms collapse under "Details".
//
// Step L4 (2026-11-15): the credits calculator (components/credits/) opens
// the groups section. It hides itself with JavaScript off, and the tables
// stay the full list either way.
//
// The answer leads (Paul, 2026-11-16: "they're supposed to be getting
// info"): the first section holds the answer, the notice and the chart, so
// the chart is the first picture. The guides scene closes the page, lazily.
//
// Every figure shares its sentence with its source, because the built-HTML
// gate reads each cell as its own line. The amount line names the source page
// and the date it was checked; attributed() names the provider in any other
// sentence with a figure. The chart's labels carry no currency sign: its
// caption and axis say what they count and where they come from. Names only,
// never logos: each program is a factual reference.
import snapshotRaw from "../../../../data/credits/startup-programs.json?raw";
import ArtImage from "../../components/art/ArtImage.astro";
import { GUIDE_ART_IMAGE, GUIDES_SCENE as art } from "../../components/guides/guide-art";
import Calculator from "../../components/credits/Calculator.astro";
import { COVER_MEANS } from "../../components/credits/calc";
import ChartFigure from "../../components/leaderboard/ChartFigure.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  amountLine,
  attributed,
  byBucket,
  cardText,
  COVER_LABELS,
  CREDITS_GUIDE,
  creditsJsonLd,
  OVERAGE_TEXT,
  parseCredits,
  programsCovering,
  shownPrograms,
  snapshotDate,
  sourceLabel,
  trainsText,
  type Cover,
  type Program,
} from "../../lib/guides/credits";
import {
  CHART_FLOOR,
  creditBars,
  creditBarsNarrow,
  creditValue,
  NO_ROUND_FILL,
  providerCredits,
  ROUND_FILL,
} from "../../lib/guides/credits-chart";
import { andList } from "../../lib/regions/page";

const credits = parseCredits(snapshotRaw);
const programs = shownPrograms(credits);
const groups = byBucket(programs);
const date = snapshotDate(credits);
const total = programs.length;
const site = Astro.site!;

const bills = programs.filter((p) => p.traps.overage === "bills").length;
const stops = programs.filter((p) => p.traps.overage === "stops").length;
const trains = programs.filter((p) => p.traps.trains_on_data === true);
const says = (p: Program, text: string) => attributed(text, p.provider);

// The chart: every provider whose page states a credit of CHART_FLOOR or more.
const byProvider = providerCredits(programs);
const charted = byProvider.filter((d) => d.amount >= CHART_FLOOR);
const below = byProvider.length - charted.length;
const usd = (n: number) => `$${n.toLocaleString("en-US")}`;
const top = charted.filter((d) => d.amount === charted[0]?.amount);
const leaders = charted.slice(0, Math.max(3, top.length)).map((d) => d.provider);
const chartText = {
  label: "The largest credit each provider states",
  description:
    `${andList(leaders)} state the largest credits, up to ${usd(charted[0]?.amount ?? 0)}, per each provider's own page. ` +
    "The legend and the data table mark which credits need a funding round or a partner code.",
};

// What the programs cover, largest first, with a short meaning for each
// (COVER_MEANS lives with the calculator, which shows the same words).
const covers = (Object.keys(COVER_LABELS) as Cover[])
  .map((c) => ({ cover: c, n: programsCovering(programs, c).length }))
  .sort((a, b) => b.n - a.n);

// The Gemini API terms, for the trap about training on your data (read
// 2026-11-02; ai.google.dev/gemini-api/terms redirects here).
const GEMINI_TERMS = "https://aistudio.google.com/docs/terms";
---

<BaseLayout
  title={CREDITS_GUIDE.title}
  description={CREDITS_GUIDE.description}
  jsonLd={creditsJsonLd(credits, site)}
>
  {/* The /ask/ search filters by this type (Pagefind). */}
  <span data-pagefind-filter="type:Guides"></span>
  <section class="section section--band" aria-labelledby="credits-title">
    <div class="wrap stack">
      <nav aria-label="Breadcrumb" class="crumbs">
        <ol>
          <li><a href="/guides/">Guides</a></li>
          <li aria-current="page">{CREDITS_GUIDE.title}</li>
        </ol>
      </nav>
      <div class="stack credits-head">
        <h1 id="credits-title">{CREDITS_GUIDE.title}</h1>
        <p class="lede" data-guide-answer>
          Startup credits are free usage that cloud and AI companies give new companies, so you can build before you
          pay. This guide compares {total} programs, each checked on the provider's own page as of <time
            datetime={date.iso}>{date.label}</time
          >. Start with the group that matches where your company is today.
        </p>
        <aside class="hall-callout hall-callout--parchment" aria-labelledby="check-title" data-credits-notice>
          <p class="hall-callout__title" id="check-title">Check before you apply</p>
          <p>
            Amounts and terms change, so read the provider's page first. Colorado Startups is not affiliated with these
            programs. Nothing here is legal, tax or financial advice.
          </p>
        </aside>
      </div>

      <h2 id="compare-title">Compare the credits</h2>
      <ul class="legend" aria-label="Bar colors">
        <li><span class="legend__swatch" style={`background: ${NO_ROUND_FILL}`} aria-hidden="true"></span>No funding round needed</li>
        <li><span class="legend__swatch" style={`background: ${ROUND_FILL}`} aria-hidden="true"></span>Needs a round or a partner code</li>
      </ul>
      <ChartFigure
        id="credit-bars"
        title={chartText.label}
        summary={chartText.description}
        svg={creditBars(charted, chartText)}
        narrowSvg={creditBarsNarrow(charted, chartText)}
        columns={["Provider", "Largest credit stated"]}
        rows={charted.map((d): [string, string] => [d.provider, creditValue(d)])}
        note={`${below} more providers state credits under ${usd(CHART_FLOOR)}, according to their own pages. The tables below list every program, each checked on its provider's page by ${date.label}.`}
      />
    </div>
  </section>

  <section class="section section--lit" id="groups" aria-labelledby="groups-title">
    <div class="wrap stack">
      {/* Step L4: the tool first, the tables below stay the full list. */}
      <Calculator programs={programs} checked={date.label} />
      <h2 id="groups-title">Which group are you in?</h2>
      <ul class="tiles">
        {
          groups.map((g) => (
            <li>
              <a class="tile panel" href={`#${g.id}`}>
                <span class="tile__n">{g.programs.length}</span>
                <span class="tile__name">{g.heading}</span>
                <span class="meta">{g.short}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <h2 id="covers-title">What the programs cover</h2>
      <ul class="covers-chart">
        {
          covers.map(({ cover, n }) => (
            <li>
              <span class="covers-chart__name">
                <strong>{COVER_LABELS[cover]}</strong> <span class="meta">{COVER_MEANS[cover]}</span>
              </span>
              <span class="covers-chart__track" aria-hidden="true">
                <span class="covers-chart__bar" style={`--share: ${(n / total).toFixed(4)}`} />
              </span>
              <span class="covers-chart__n">{`${n} of ${total}`}</span>
            </li>
          ))
        }
      </ul>
      <p class="meta">Programs on this page, each checked on its provider's page as of {date.label}.</p>
    </div>
  </section>

  <section class="section section--band" id="order" aria-labelledby="order-title">
    <div class="wrap stack">
      <h2 id="order-title">Apply in this order</h2>
      <ol class="steps">
        <li><strong>Start with no company.</strong> Build a prototype on the first group's credits.</li>
        <li><strong>Form the company before you ask for more.</strong> Many check its name, website or business email.</li>
        <li><strong>Pick one platform and apply there first.</strong> Credits expire.</li>
        <li>
          <strong>Ask for a partner code when you raise or join an accelerator.</strong> The largest tiers need one, such as
          an AWS Activate Organization ID.
        </li>
        <li><strong>Set a budget alert on the first day.</strong> Credits hide your real costs.</li>
      </ol>
      <details class="traps" id="traps">
        <summary><span id="traps-title">Watch for these traps</span></summary>
        <ul>
          <li>
            <strong>A card on file.</strong> Many programs ask for a card, even for a free credit. Google places a temporary
            hold on it, and AWS and Microsoft require one to activate the account.
          </li>
          <li>
            <strong>Expiry.</strong> Google's trial lasts 90 days and Azure's free credit lasts 30 days. Google's Start tier
            and Cloudflare's credits last one year, and AWS sets an expiry date on each grant.
          </li>
          <li>
            <strong>Billing after the credits end.</strong> Of the {total} programs here, {bills} bill usage past the credits
            and {stops} stop the service. The rest don't say. Google's trial and Azure's free account stop rather than charge
            you, while Microsoft for Startups switches to pay-as-you-go on its own.
          </li>
          <li>
            <strong>What a credit leaves out.</strong> Google's trial can't add GPUs. Google's and Microsoft's startup credits
            don't pay for third-party AI models.
          </li>
          <li>
            <strong>Training on your data.</strong> Read an AI provider's data terms before you send it customer data.
            {
              trains.length > 0 &&
                ` On this page, the terms of ${andList(trains.map((p) => p.program))} let the provider train on your data.`
            } Google's{" "}
            <a href={GEMINI_TERMS} rel="noopener nofollow">Gemini API terms</a> say Google uses what you send its unpaid services
            to improve its products, and human reviewers may read it. For paid services, those terms say Google doesn't use
            your prompts or responses to improve its products.
          </li>
        </ul>
        <p class="meta">Each trap comes from the provider pages linked in the tables below, checked {date.label}.</p>
      </details>
    </div>
  </section>

  {
    groups.map((g, i) => (
      <section
        class:list={["section", i % 2 === 0 ? "section--lit" : "section--band"]}
        id={g.id}
        aria-labelledby={`${g.id}-title`}
        data-credits-group={g.id}
      >
        <div class="wrap stack">
          <h2 id={`${g.id}-title`}>{g.heading}</h2>
          <p>{g.intro}</p>
          <div class="scroll" role="region" aria-labelledby={`${g.id}-caption`} tabindex="0">
            {/* The explicit roles keep the table's meaning for screen readers when
                narrow screens restyle its rows as cards (display: block). */}
            <table role="table">
              <caption id={`${g.id}-caption`}>{`Programs for founders: ${g.heading.toLowerCase()}`}</caption>
              <thead role="rowgroup">
                <tr role="row">
                  <th scope="col" role="columnheader">
                    Program
                  </th>
                  <th scope="col" role="columnheader">
                    Amount
                  </th>
                  <th scope="col" role="columnheader">
                    Covers
                  </th>
                  <th scope="col" role="columnheader">
                    Details
                  </th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                {g.programs.map((p) => (
                  <tr id={`p-${p.id}`} data-program={p.id} role="row">
                    <th scope="row" role="rowheader">
                      <p>
                        <a href={p.link} rel="noopener nofollow">
                          {p.program}
                        </a>
                      </p>
                      <p class="meta">{p.provider}</p>
                    </th>
                    <td data-amount data-label="Amount" role="cell">
                      {/* One sentence: the provider's own amount, its source page and the
                          date it was checked. A computed total gets its own labeled line. */}
                      <p data-amount-line>
                        {`${amountLine(p).stated}, per `}
                        <a href={p.source} rel="noopener nofollow">
                          {sourceLabel(p.source)}
                        </a>
                        {", checked "}
                        <time datetime={p.checked}>{p.checked}</time>.
                      </p>
                      {amountLine(p).computed && <p data-amount-computed>{`${amountLine(p).computed}.`}</p>}
                    </td>
                    <td data-label="Covers" role="cell">
                      <ul class="covers" aria-label="Covers">
                        {p.covers.map((c) => (
                          <li data-cover={c}>{COVER_LABELS[c]}</li>
                        ))}
                      </ul>
                    </td>
                    <td data-label="Details" role="cell">
                      <details data-program-details>
                        <summary>
                          What you need and terms<span class="visually-hidden">: {p.program}</span>
                        </summary>
                        <p>{says(p, p.amount_note)}</p>
                        <p>
                          <strong>What you need:</strong>
                        </p>
                        <ul class="needs">
                          {p.requirements.map((r) => (
                            <li>{says(p, r)}</li>
                          ))}
                        </ul>
                        <p>
                          <strong>Card:</strong> {cardText(p.traps.card_required)}
                        </p>
                        {p.term && (
                          <p>
                            <strong>Term:</strong> {says(p, p.term)}
                          </p>
                        )}
                        <p>
                          <strong>Past the credits:</strong> {OVERAGE_TEXT[p.traps.overage]}
                        </p>
                        {trainsText(p) && (
                          <p>
                            <strong>Trains on your data:</strong> {trainsText(p)}
                          </p>
                        )}
                        {p.traps.expiry && (
                          <p>
                            <strong>Expiry:</strong> {says(p, p.traps.expiry)}
                          </p>
                        )}
                        {p.traps.other.length > 0 && (
                          <ul class="needs">
                            {p.traps.other.map((o) => (
                              <li>{says(p, o)}</li>
                            ))}
                          </ul>
                        )}
                      </details>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    ))
  }

  <section
    class:list={["section", groups.length % 2 === 0 ? "section--lit" : "section--band"]}
    id="partners"
    aria-labelledby="partners-title"
  >
    <div class="wrap stack">
      <h2 id="partners-title">Find a partner in Startup Resources</h2>
      <p>The largest credits come through accelerators and investors. Startup Resources lists the ones in Colorado.</p>
      <p class="btn-row">
        <a class="btn btn--gold" href="/guides/colorado-accelerators-and-incubators/">Accelerators and incubators</a>
        <a class="btn btn--stone" href="/guides/funding-programs/">Funding programs</a>
      </p>
      <p class="meta">
        Resourcus, an AI agent run by Colorado Startups, answers questions about Startup Resources on the{" "}
        <a href="/ask/">Ask page</a>. It knows the Colorado programs, not these credit offers, and it can make mistakes.
      </p>
    </div>
  </section>

  <section
    class:list={["section", groups.length % 2 === 0 ? "section--band" : "section--lit"]}
    id="about"
    aria-labelledby="about-title"
  >
    <div class="wrap stack">
      <h2 id="about-title">About this guide</h2>
      <p>
        Colorado Startups is not affiliated with these programs or the companies that run them, and none of them pays to
        appear here. Each name is used only to identify a program. Nothing here is legal, tax or financial advice.
      </p>
      <p>
        Each row was read on the provider's own page on the date beside its amount, as of <time datetime={date.iso}
          >{date.label}</time
        >. A total marked "computed here" is Colorado Startups' own arithmetic from the provider's figures, not a number
        the provider states. Spot a change? <a href="/contact/">Tell us</a>, and a person will check it.
      </p>
      <p><a href="/guides/">More guides for founders</a></p>
      <ArtImage src={art.src} alt={art.alt} {...GUIDE_ART_IMAGE} loading="lazy" motion="none" class="guide-art" />
    </div>
  </section>
</BaseLayout>

<style>
  /* The answer and its notice at reading width, so the chart under them
     starts in the first screen on a wide one. */
  .credits-head {
    max-width: var(--t-measure);
  }
  /* The guides scene closes the page (L6's scenes, 2026-11-04). */
  :global(.guide-art) {
    width: min(100%, 40rem);
    border-radius: var(--r-card);
    box-shadow: var(--sh-glow);
  }
  /* The breadcrumb's look, and its 44 px phone targets, are global.css's
     .crumbs (#682). */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    padding: 0;
    list-style: none;
    font-size: var(--t-step--1);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }
  .legend__swatch {
    width: 1rem;
    height: 0.75rem;
    border-radius: var(--r-chisel);
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--s-4);
    max-width: none;
    padding: 0;
    list-style: none;
  }
  .tile {
    display: grid;
    align-content: start;
    gap: var(--s-1);
    height: 100%;
    color: var(--c-text);
    text-decoration: none;
  }
  .tile__n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-step-4);
    line-height: 1;
  }
  .tile__name {
    font-weight: 700;
    color: var(--ink-link, var(--c-link));
  }
  .tile:hover .tile__name,
  .tile:focus-visible .tile__name {
    text-decoration: underline;
  }
  .tiles + h2,
  :global(.calc) + h2 {
    margin-top: var(--s-7);
  }
  /* What the programs cover: a name, a bar and a count per row, bars aligned. */
  .covers-chart {
    display: grid;
    gap: var(--s-2);
    max-width: 48rem;
    padding: 0;
    list-style: none;
  }
  .covers-chart li {
    display: grid;
    grid-template-columns: minmax(12rem, 22rem) minmax(0, 1fr) 6ch;
    align-items: center;
    gap: var(--s-3);
  }
  .covers-chart__track {
    height: 0.75rem;
    border-radius: var(--r-chisel);
    background: var(--c-surface-2);
  }
  .covers-chart__bar {
    display: block;
    width: calc(var(--share) * 100%);
    height: 100%;
    border-radius: 0 var(--r-chisel) var(--r-chisel) 0;
    background: var(--c-text-dim);
  }
  .covers-chart__n {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }
  @media (max-width: 40rem) {
    .covers-chart li {
      grid-template-columns: minmax(0, 1fr) 6ch;
      gap: var(--s-1) var(--s-3);
    }
    .covers-chart__name {
      grid-column: 1 / -1;
    }
  }
  .steps li {
    margin-bottom: var(--s-2);
  }
  /* A disclosure keeps the browser's own triangle, so it reads as one, and a
     44 px row to tap. */
  .traps summary,
  td details summary {
    display: list-item;
    min-height: var(--size-tap);
    padding-block: var(--s-2);
  }
  .traps li {
    margin-bottom: var(--s-3);
  }
  .scroll {
    overflow-x: auto;
    max-width: 100%;
    border: var(--line-hair) solid var(--c-rule);
    border-radius: var(--r-chisel);
  }
  table {
    width: 100%;
    min-width: 48rem;
    border-collapse: collapse;
    font-size: var(--t-step--1);
  }
  caption {
    text-align: left;
    padding: var(--s-3);
    font-weight: 700;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: var(--s-2) var(--s-3);
    border-top: var(--line-hair) solid var(--c-rule);
  }
  td a {
    overflow-wrap: anywhere;
  }
  thead th {
    background: var(--c-surface);
  }
  tbody th {
    font-weight: 400;
    width: 13rem;
  }
  tbody th a {
    font-weight: 700;
  }
  th p,
  td p {
    margin: 0 0 var(--s-2);
  }
  th p:last-child,
  td p:last-child {
    margin-bottom: 0;
  }
  .needs {
    margin: 0 0 var(--s-2);
    padding-left: var(--s-4);
  }
  .needs li {
    margin-bottom: var(--s-1);
  }
  summary {
    cursor: pointer;
    font-weight: 700;
  }
  td details summary {
    color: var(--ink-link, var(--c-link));
  }
  details[open] summary {
    margin-bottom: var(--s-2);
  }
  .covers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .covers li {
    padding: 0 var(--s-2);
    border: var(--line-hair) solid var(--c-rule);
    border-radius: var(--r-chisel);
    font-weight: 700;
    font-size: var(--t-step--1);
    white-space: nowrap;
  }
  /* On a phone each program becomes a card: the name on top, then each cell
     under its column name. The header row stays for screen readers only. */
  @media (max-width: 40rem) {
    .scroll {
      overflow: visible;
      border: 0;
    }
    table {
      min-width: 0;
    }
    table,
    tbody,
    tr,
    tbody th,
    td {
      display: block;
    }
    caption {
      display: block;
      padding-inline: 0;
    }
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    tbody tr {
      margin-bottom: var(--s-4);
      border: var(--line-hair) solid var(--c-rule);
      border-radius: var(--r-chisel);
    }
    tbody th {
      width: auto;
      border-top: 0;
      background: var(--c-surface);
    }
    td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: var(--s-1);
      font-weight: 700;
      color: var(--c-text-dim);
    }
  }
</style>
