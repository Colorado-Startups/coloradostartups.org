---
// /guides/: the answer pages, each built from Startup Resources. Owner: L23;
// L32 grouped them (GUIDE_GROUPS) when the city and events guides came in. The
// ecosystem-canvas page links here; the orchestrator adds the llms.txt lines
// when a guides lane merges. S7 added the startup credits guide as its own
// group: its programs come from data/credits/, not Startup Resources.
//
// Step F of the redesign (2026-11-15): one tile per guide, its title and the
// number of listings it draws on, so a visitor picks a question at a glance.
import snapshotRaw from "../../../../data/credits/startup-programs.json?raw";
import ArtImage from "../../components/art/ArtImage.astro";
import { GUIDE_ART_IMAGE, GUIDES_SCENE as art } from "../../components/guides/guide-art";
import GuideText from "../../components/guides/GuideText.astro";
import { guideInput } from "../../components/guides/guide-data";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CREDITS_GUIDE, parseCredits, shownPrograms } from "../../lib/guides/credits";
import { buildGuide, GUIDE_GROUPS, guideItems, GUIDES_INDEX, guidesIndexJsonLd, type Part } from "../../lib/guides/guides";

const input = await guideInput();
const groups = GUIDE_GROUPS.map((g, i) => ({
  ...g,
  id: `group-${i + 1}`,
  guides: g.slugs.map((slug) => buildGuide(slug, input)),
}));
const creditPrograms = shownPrograms(parseCredits(snapshotRaw));
const site = Astro.site!;

const answer: Part[] = [
  "These guides answer the questions founders ask most about building a company in Colorado, by topic and by city. ",
  `Each draws on Startup Resources, which the community keeps current. Startup Resources lists ${input.records.length} active resources as of `,
  { text: input.date.label, datetime: input.date.iso },
  ".",
];
---

<BaseLayout
  title={GUIDES_INDEX.title}
  description={GUIDES_INDEX.description}
  jsonLd={guidesIndexJsonLd([...groups.flatMap((g) => g.guides), CREDITS_GUIDE], site)}
>
  {/* The /ask/ search filters by this type (Pagefind). */}
  <span data-pagefind-filter="type:Guides"></span>
  <section class="section section--band" aria-labelledby="guides-title">
    <div class="wrap guides-head">
      <div class="stack">
        <h1 id="guides-title">{GUIDES_INDEX.title}</h1>
        <p class="lede" data-guide-answer><GuideText parts={answer} /></p>
      </div>
      <ArtImage
        src={art.src}
        alt={art.alt}
        {...GUIDE_ART_IMAGE}
        loading="lazy"
        motion="none"
        class="guide-art"
      />
    </div>
  </section>

  <div class="section section--lit">
    <div class="wrap stack">
      {
        groups.map((group) => (
          <div class="guide-group">
            <h2 id={`${group.id}-title`}>{group.heading}</h2>
            <ul class="guides" data-guide-list>
              {group.guides.map((g) => (
                <li class="guide-tile panel" data-guide-item>
                  <p class="guide-tile__n">{guideItems(g).length}</p>
                  <h3>
                    <a href={g.path}>{g.title}</a>
                  </h3>
                  <p class="meta">listings from Startup Resources</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="guide-group">
        <h2 id="credits-group-title">Pay for your first servers</h2>
        <ul class="guides" data-guide-list>
          <li class="guide-tile panel" data-guide-item>
            <p class="guide-tile__n">{creditPrograms.length}</p>
            <h3>
              <a href={CREDITS_GUIDE.path}>{CREDITS_GUIDE.title}</a>
            </h3>
            <p class="meta">programs from cloud and AI companies, not Startup Resources</p>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <section class="section section--band" aria-labelledby="else-title">
    <div class="wrap stack">
      <h2 id="else-title">Looking for something else?</h2>
      <p class="btn-row"><a class="btn btn--stone" href="/ecosystem-canvas/">Browse Startup Resources</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  /* The guide's picture under its answer (L6's scenes, 2026-11-04). */
  :global(.guide-art) {
    width: min(100%, 40rem);
    border-radius: var(--r-card);
    box-shadow: var(--sh-glow);
  }
  /* The answer beside the picture on a wide screen, so the tiles start in
     the first screen. */
  .guides-head {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .guides-head {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }
  .guide-group + .guide-group {
    margin-top: var(--s-7);
  }
  .guide-group h2 {
    margin-bottom: var(--s-3);
  }
  .guides {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--s-4);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }
  /* A tile: the count large, then the question it answers. */
  .guide-tile {
    display: grid;
    align-content: start;
    gap: var(--s-1);
  }
  .guide-tile p,
  .guide-tile h3 {
    margin: 0;
  }
  .guide-tile h3 {
    font-size: var(--t-step-1);
    line-height: 1.25;
  }
  .guide-tile__n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-step-4);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
</style>
