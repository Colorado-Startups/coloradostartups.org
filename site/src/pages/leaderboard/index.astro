---
// /leaderboard/: who builds here. The three build-time charts first, then the
// latest edition as a searchable, sortable table with theme chips, with "How
// the Leaderboard works" folded into a <details> under it, and last a short
// nominate band (the redesign, 2026-11-15: visual first, few words). The page
// says nothing about investing (decision 17), so the old "Recruit Series B"
// band is gone. Styled with existing tokens only. Owner: L2.
//
// The title is carved in a lintel, and the Great Hall picture sits beside the
// lede from 64rem (#239, #723). On a phone the picture stays a small seal
// under the actions, smaller than the lede, so the lede stays the largest
// thing in the first screen and the mobile LCP stays text. Its alt is
// HALL_ART_ALT, the brand's caption.
//
// L3b: the honorees list has a Table and Cards switch (HonoreesTable), and
// the "Ask your AI" row (A3a) sits once on the page, in a band between the
// honorees and the nominate hearth. Its question asks about companies only.
import { getCollection } from "astro:content";

import AskAi from "../../components/ai/AskAi.astro";
import ArtImage from "../../components/art/ArtImage.astro";
import { HALL_ART_ALT } from "../../components/art/keepers";
import ChartFigure from "../../components/leaderboard/ChartFigure.astro";
import CityPanel from "../../components/leaderboard/CityPanel.astro";
import HonoreesTable from "../../components/leaderboard/HonoreesTable.astro";
import Banner from "../../components/ui/Banner.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildBoard, companiesByCity, countBy, foundingYears, latestEdition, topWithTies } from "../../lib/leaderboard/board";
import {
  foundingTimeline,
  foundingTimelineNarrow,
  hqMap,
  hqMapNarrow,
  sectorBars,
  sectorBarsNarrow,
} from "../../lib/leaderboard/charts";
import { COMPANY_NOTES } from "../../lib/leaderboard/notes";
import { isColoradoCity } from "../../lib/leaderboard/places";

const companies = (await getCollection("companies")).map((e) => e.data);
const edition = latestEdition((await getCollection("editions")).map((e) => e.data));
if (!edition) throw new Error("no Leaderboard edition in data/leaderboard/editions/");

const rows = buildBoard(edition, companies);
const total = rows.length;

const cities = countBy(rows, (r) => r.company.hq_city);
const coloradoCities = cities.filter((c) => isColoradoCity(c.key));
// The map panel lists only the cities the map draws a dot for (L3a).
const mappedCities = companiesByCity(rows, isColoradoCity);
const outsideCount = rows.filter((r) => !isColoradoCity(r.company.hq_city)).length;
const sectors = countBy(rows, (r) => r.company.sector);
const years = foundingYears(rows);
const datedCount = years.reduce((n, y) => n + y.count, 0);

const top = topWithTies(coloradoCities, 3).map((c) => `${c.key} (${c.count})`).join(", ");
const mapSummary =
  `Each dot is a Colorado city where honorees have their headquarters, sized by the number of companies. ` +
  `The most are in ${top}.` +
  (outsideCount === 1
    ? " One honoree lists a headquarters outside Colorado and is not mapped."
    : outsideCount > 1
      ? ` ${outsideCount} honorees list a headquarters outside Colorado and are not mapped.`
      : "");
const sectorSummary = `Honorees by the industry they serve. The largest sectors are ${topWithTies(sectors, 3)
  .map((s) => `${s.key} (${s.count})`)
  .join(", ")}.`;
const yearSummary =
  years.length > 0
    ? `Honorees by founding year, from ${years[0]!.year} to ${years.at(-1)!.year}. ` +
      `${datedCount} of ${total} companies state a founding year in a source we could cite.`
    : "No honoree states a founding year in a source we could cite.";

// The meta description says what this edition is (GO-LIVE C4). The 2026
// Honorees are unranked and listed A to Z (edition summary), so it makes no
// ranking claim. test/dom/l2/leaderboard-claims.test.ts fails when the latest
// edition's kind and this wording disagree.
const description = `${edition.title}: companies building in Colorado that we verified from public sources. This edition is unranked, lists them A to Z and links every source.`;

// "Oct 18, 2026": the ISO date broke at its hyphens on a phone.
const published = new Intl.DateTimeFormat("en-US", { timeZone: "UTC", month: "short", day: "numeric", year: "numeric" }).format(
  new Date(`${edition.published}T12:00:00Z`),
);

const mapText = { label: "Map of Colorado HQ cities", description: mapSummary };
const sectorText = { label: "Honorees by sector", description: sectorSummary };
const yearText = { label: "Honorees by founding year", description: yearSummary };
---

<BaseLayout
  title="The Leaderboard"
  description={description}
  ogImage="leaderboard"
>
  {/* The /ask/ search filters by this type (Pagefind). */}
  <span data-pagefind-filter="type:Companies"></span>
  <section class="section section--lit">
    <div class="wrap lb-hero">
      <div>
        <Banner as="h1" variant="lintel">The Leaderboard</Banner>
        <p class="lede">Companies building in Colorado, each verified from public sources.</p>
        <div class="btn-row">
          <a class="btn btn--gold" href="/leaderboard/nominate/">Nominate your company</a>
          <a class="btn btn--stone" href={`#${edition.id}`}>Find a company</a>
        </div>
      </div>
      <ArtImage
        src="brand/golden"
        alt={HALL_ART_ALT}
        aspect="21 / 9"
        widths={[400, 640, 960]}
        sizes="(min-width: 64rem) 26rem, 14rem"
        loading="lazy"
        motion="none"
        class="lb-hero__art"
      />
    </div>
  </section>

  <section class="section section--band" aria-labelledby="glance">
    <div class="wrap">
      <h2 id="glance">Who builds here</h2>
      {/* Every figure below is a count of this edition's rows. */}
      <p class="meta lb-source">
        {total} companies in the {edition.title}, as of <time datetime={edition.published}>{published}</time>.
        Source: Colorado Startups.
      </p>
      <ChartFigure
        id="chart-map"
        title="Where they are"
        summary={mapSummary}
        svg={hqMap(coloradoCities, mapText)}
        narrowSvg={hqMapNarrow(coloradoCities, mapText)}
        columns={["HQ city", "Companies"]}
        rows={cities.map((c) => [c.key, c.count])}
        note="Cities outside Colorado are written with their state."
      >
        <CityPanel id="chart-map-panel" cities={mappedCities} />
      </ChartFigure>
      <ChartFigure
        id="chart-sectors"
        title="What they build"
        summary={sectorSummary}
        svg={sectorBars(sectors, sectorText)}
        narrowSvg={sectorBarsNarrow(sectors, sectorText)}
        columns={["Sector", "Companies"]}
        rows={sectors.map((s) => [s.key, s.count])}
      />
      <ChartFigure
        id="chart-years"
        title="When they started"
        summary={yearSummary}
        svg={foundingTimeline(years, yearText)}
        narrowSvg={foundingTimelineNarrow(years, yearText)}
        columns={["Year founded", "Companies"]}
        rows={years.map((y) => [y.year, y.count])}
        note={`${total - datedCount} companies with no cited founding year are left out.`}
      />
    </div>
  </section>

  <section class="section section--lit" aria-labelledby={edition.id}>
    <div class="wrap">
      <h2 id={edition.id}>{edition.title}</h2>
      <p class="meta">
        {total} companies, A to Z, as of <time datetime={edition.published}>{published}</time>. Every listing links
        its sources.{" "}
        <a href="/leaderboard/kit/">Listed? Get the honoree badge.</a>
      </p>
      <HonoreesTable rows={rows} caption={`${edition.title}, A to Z`} notes={COMPANY_NOTES} />
      <details class="lb-method" id="method">
        <summary>How the Leaderboard works</summary>
        <h3>This edition</h3>
        <p>{edition.summary}</p>
        <p>{edition.method}</p>
        <h3>Verified editions</h3>
        <p>
          From the first verified edition on, we rank companies by how fast their revenue grew over three years. A
          company needs a minimum revenue in its first year to qualify. That keeps a tiny start from showing a false
          growth rate. Companies compete in two tiers, Startup and Growth, so a young company is judged against its
          peers.
        </p>
        <p>
          We publish the minimum and the tier limits before nominations close. We ask each company for documents that
          prove its numbers. The Leaderboard shows revenue as a range, never an exact figure.
        </p>
      </details>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="ask-ai">
    <div class="wrap">
      <AskAi
        subject="The Leaderboard"
        path="/leaderboard/"
        question="Which companies on it build in my city or sector, and what does each one make?"
      />
    </div>
  </section>

  <section class="section section--hearth" aria-labelledby="nominate">
    <div class="wrap">
      <h2 id="nominate">Building in Colorado?</h2>
      <div class="btn-row">
        <a class="btn btn--gold" href="/leaderboard/nominate/">Nominate your company</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // A link to #method (llms.txt names it) opens the fold it lands on.
  const method = document.getElementById("method");
  const openMethod = () => {
    if (location.hash === "#method" && method instanceof HTMLDetailsElement) method.open = true;
  };
  openMethod();
  addEventListener("hashchange", openMethod);
</script>

<style>
  .lb-hero {
    display: grid;
    gap: var(--s-6);
    align-items: center;
  }
  /* A small seal on a phone (14rem); ArtImage renders the figure in its own
     scope, so this reaches it by class. */
  .lb-hero :global(.lb-hero__art) {
    width: min(100%, 14rem);
    border-radius: var(--r-card);
    box-shadow: var(--sh-glow);
  }
  /* Text and picture side by side from 64rem, the text wider. */
  @media (min-width: 64rem) {
    .lb-hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--s-7);
    }
    .lb-hero :global(.lb-hero__art) {
      width: min(100%, 26rem);
      justify-self: end;
    }
  }
  .lb-source {
    margin-bottom: var(--s-6);
  }
  .lb-method {
    margin-top: var(--s-5);
    max-width: var(--t-measure);
  }
  /* The summary stays a list item, so it keeps the native marker; the
     padding makes it a full tap target. */
  .lb-method summary {
    min-height: var(--size-tap);
    padding-block: var(--s-2);
    font-weight: 700;
    cursor: pointer;
  }
</style>
