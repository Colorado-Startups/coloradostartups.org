---
// /community/: pick a channel (Paul, 2026-11-15: visual first, few words).
// Owner: L1. 301 target for /overview and /social-groups (ops/redirects).
//
// - The brand's crest banner (brand v4.0.0, dist/logo/banner-*.png, pinned in
//   brand.lock.json) and one line: founders first, then the people who back
//   them (decision 46).
// - Four channel tiles: the ways in, from WAYS (ways.ts), so every href comes
//   from WAYS_IN. The Slack tile holds the one gold button.
// - Three house rules as icons: the Code of Conduct's "Promotion and limits"
//   rules, titles word for word from code-of-conduct.ts. People moderate.
// - The welcome desk, with Communitas disclosed as an AI agent (WelcomeDesk).
//
// No line here states a member count.
import { CONDUCT_GROUPS } from "../../components/info/code-of-conduct";
import ChannelTile from "../../components/community/ChannelTile.astro";
import { communityIcon, type RuleIcon } from "../../components/community/icons";
import WelcomeDesk from "../../components/communitas/WelcomeDesk.astro";
import { CHANNELS } from "../../components/hall/channels";
import { WAYS } from "../../components/hall/ways";
import BaseLayout from "../../layouts/BaseLayout.astro";

// The tiles follow WAYS, the four ways in; each draws its icon from its channel.
const tiles = WAYS.map((way) => CHANNELS.find((c) => c.id === way.kind)!);

// The three promotion rules, each with an icon and a few words of its own body.
const RULE_ART: Record<string, { icon: RuleIcon; note: string }> = {
  "Promote in One Place": { icon: "one-place", note: "Each group's weekly thread" },
  "No Investment Offers": { icon: "no-invest", note: "No funds or open rounds" },
  "No Cold Pitches": { icon: "no-pitch", note: "No sales pitches by message" },
};
const promotion = CONDUCT_GROUPS.find((g) => g.id === "promotion-and-limits");
if (!promotion) throw new Error("code-of-conduct.ts has no promotion-and-limits group");
const rules = promotion.rules.map((r) => {
  const art = RULE_ART[r.title];
  if (!art) throw new Error(`/community/ has no icon for the Code of Conduct rule "${r.title}"`);
  return { title: r.title, ...art };
});

// The banner is portrait, 4:5. Shown at 240 px wide (120 to 150 px on phones), so
// the 480 px file covers 2x and 3x screens; the 960 px file is for zoom.
const BANNER_SIZES = "(max-width: 480px) 120px, (max-width: 760px) 150px, 240px";
---

<BaseLayout
  title="Community"
  description="Pick your way into Colorado Startups: the Slack, the LinkedIn Group, the LinkedIn Page or the Startupers newsletter. Founders come first."
  ogImage="community"
>
  <section class="section section--night hero" aria-labelledby="community-title">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <h1 id="community-title">Community</h1>
        <p class="lede">For founders building companies in Colorado, and the people who back them.</p>
      </div>
      <img
        class="hero__banner"
        src="/art/brand/banner-480x600.png"
        srcset="/art/brand/banner-480x600.png 480w, /art/brand/banner-960x1200.png 960w"
        sizes={BANNER_SIZES}
        width="480"
        height="600"
        alt="The Colorado Startups crest, a winged shield over snowy peaks, on a royal-blue banner."
        loading="eager"
        decoding="async"
      />
    </div>
  </section>

  <section class="section section--lit" aria-labelledby="channels-title">
    <div class="wrap">
      <h2 id="channels-title">Pick a channel</h2>
      <ul class="hall-grid channels" role="list">
        {tiles.map((channel) => <ChannelTile channel={channel} />)}
      </ul>
    </div>
  </section>

  <section class="section section--band" aria-labelledby="rules-title">
    <div class="wrap">
      <h2 id="rules-title">House rules</h2>
      <ul class="rules" role="list" data-rules>
        {
          rules.map((r) => (
            <li class="rule" data-rule={r.icon}>
              <span class="rule__icon" set:html={communityIcon(r.icon)} />
              <strong>{r.title}</strong>
              <span class="rule__note">{r.note}</span>
            </li>
          ))
        }
      </ul>
      <p class="rules__foot">
        People moderate. The AI keepers never do. <a href="/code-of-conduct/">Read the Code of Conduct</a>{" or "}
        <a href="/get-involved/">take a seat</a>.
      </p>
    </div>
  </section>

  <section class="section section--lit" aria-labelledby="desk-title">
    <div class="wrap">
      <h2 id="desk-title">Find your door</h2>
      <WelcomeDesk />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--s-7);
    --ink-link: var(--c-gold-on-night);
    --focus-ring: var(--c-focus-on-night);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-6);
  }
  .hero h1 {
    margin: 0 0 var(--s-3);
    color: var(--c-on-night);
  }
  .hero .lede {
    margin: 0;
    color: var(--c-on-night);
  }
  /* The banner's file has a night ground of its own. "lighten" keeps the
     brighter of it and the band's night, so its edges vanish in both themes. */
  .hero__banner {
    display: block;
    width: 240px;
    height: auto;
    mix-blend-mode: lighten;
  }

  /* A list gets the reading measure by default (global.css); these are grids. */
  .channels,
  .rules {
    max-width: none;
  }
  /* Two by two, four across on a wide screen, one column on a phone: never
     three and an orphan. */
  .channels {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--s-5);
  }
  @media (min-width: 1200px) {
    .channels {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .channels {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .rules {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
    margin: var(--s-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .rule {
    display: grid;
    justify-items: center;
    gap: var(--s-2);
    text-align: center;
  }
  .rule__icon {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: var(--line-bold) solid var(--c-accent);
    background: var(--c-ground);
    color: var(--c-fire);
  }
  .rule__icon :global(svg) {
    width: 36px;
    height: 36px;
  }
  .rule__note {
    color: var(--c-text-dim);
    font-size: var(--t-step--1);
  }
  .rules__foot {
    margin: var(--s-6) auto 0;
    text-align: center;
  }

  @media (max-width: 760px) {
    .hero {
      padding-block: var(--s-6);
    }
    .hero__banner {
      width: 150px;
    }
    .rules {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }
    .rule {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto auto;
      justify-items: start;
      align-items: center;
      column-gap: var(--s-4);
      row-gap: 0;
      text-align: left;
    }
    .rule__icon {
      grid-row: span 2;
      width: 56px;
      height: 56px;
    }
    .rule__icon :global(svg) {
      width: 28px;
      height: 28px;
    }
    .rules__foot {
      text-align: left;
    }
  }
  /* On a phone the title takes the full width, and the banner hangs beside
     the line under it. */
  @media (max-width: 560px) {
    .hero__grid {
      grid-template-areas:
        "title title"
        "lede banner";
      column-gap: var(--s-4);
      row-gap: 0;
    }
    .hero__copy {
      display: contents;
    }
    .hero h1 {
      grid-area: title;
    }
    .hero .lede {
      grid-area: lede;
    }
    .hero__banner {
      grid-area: banner;
      width: 120px;
    }
  }
</style>
