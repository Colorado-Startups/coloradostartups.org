---
// Builders (step P1): 12 companies from the latest Leaderboard edition, right
// under the hero, so the page's first promise ("Meet the founders building
// companies in Colorado") shows companies at once. lib/home/builders.ts picks
// them the same way on every build, spread across the regions and their
// cities. Companies only, never people, and nothing about investing
// (decision 17).
//
// | Shows | How |
// | --- | --- |
// | Name and city | always, as one link to the company's row on /leaderboard/ |
// | Region | a peak in the region's color (REGION_COLORS); its name for screen readers |
// | One line about it | on hover, keyboard focus or a first tap; Escape closes it |
//
// The line is the link's description (aria-describedby), so a screen reader
// hears it with the name. Its visible copy is aria-hidden, the way a tooltip
// repeats a description, and it is not on screen until opened, so the band's
// word count leaves it out. builders.test.ts caps each line at 20 words.
// CSS opens the line; the script below only adds Escape and the first tap.
import { WAYS_IN, type RegionId } from "@cs/shared";
import { getCollection } from "astro:content";

import { pickBuilders } from "../../../lib/home/builders";
import { buildBoard, latestEdition } from "../../../lib/leaderboard/board";
import { REGION_COLORS } from "../../../lib/regions/map";
import { ELSEWHERE, REGIONS } from "../../../lib/regions/match";

const companies = (await getCollection("companies")).map((e) => e.data);
const edition = latestEdition((await getCollection("editions")).map((e) => e.data));
const board = edition ? buildBoard(edition, companies).map((row) => row.company) : [];
const builders = pickBuilders(board, REGIONS);
const regionName = new Map<string, string>(REGIONS.map((r) => [r.id, r.name]));
const color = (region: string) => (region === ELSEWHERE ? "var(--c-text-dim)" : REGION_COLORS[region as RegionId]);
---

{
  builders.length > 0 && (
    <section class="section builders" aria-labelledby="builders">
      <div class="wrap">
        <h2 id="builders">Builders</h2>
        <ul class="builders__list" role="list" data-builders>
          {builders.map((b) => (
            <li class="builder" style={`--region-color: ${color(b.region)}`} data-builder={b.id}>
              <a class="builder__link" href={`${WAYS_IN.leaderboard}#company-${b.id}`} aria-describedby={`builder-${b.id}-line`}>
                <span class="builder__peak" aria-hidden="true" />
                <span class="builder__name">{b.name}</span>
                <span class="builder__city">
                  {b.city}
                  <span class="visually-hidden">, {regionName.get(b.region) ?? "outside the three regions"}</span>
                </span>
              </a>
              <span class="builder__line" id={`builder-${b.id}-line`} aria-hidden="true">
                {b.line}
              </span>
            </li>
          ))}
        </ul>
        <p class="builders__more">
          <a href={WAYS_IN.leaderboard}>See all companies</a>{" "}
          <a href="/leaderboard/nominate/">Nominate a company</a>
        </p>
      </div>
    </section>
  )
}

<script>
  // Escape closes an open line (hover content must be dismissible) until the
  // pointer or focus moves again. On touch, the first tap on a company opens
  // its line and the second follows the link.
  const list = document.querySelector<HTMLElement>("[data-builders]");
  if (list) {
    let touch = false;
    const closeAll = () => list.querySelectorAll("[data-open]").forEach((el) => el.removeAttribute("data-open"));
    list.addEventListener("pointerdown", (e) => {
      touch = e.pointerType === "touch";
    });
    list.addEventListener("click", (e) => {
      const item = (e.target as Element).closest<HTMLElement>("[data-builder]");
      if (!touch || !item || item.hasAttribute("data-open")) return;
      e.preventDefault();
      closeAll();
      list.removeAttribute("data-dismissed");
      item.setAttribute("data-open", "");
    });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      closeAll();
      list.setAttribute("data-dismissed", "");
    });
    document.addEventListener("pointerdown", (e) => {
      if (!list.contains(e.target as Node)) closeAll();
    });
    const reopen = () => list.removeAttribute("data-dismissed");
    list.addEventListener("pointerover", reopen);
    list.addEventListener("focusin", reopen);
  }
</script>

<style>
  /* A list gets the reading measure by default (global.css); this one is a grid. */
  .builders__list {
    max-width: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 var(--s-4);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .builder {
    position: relative;
    border-top: var(--line-hair) solid var(--c-rule);
  }
  .builder__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--s-2);
    align-items: baseline;
    min-height: var(--size-tap);
    padding-block: var(--s-3);
    text-decoration: none;
  }
  /* A peak in the region's color: the regions are named for mountains. */
  .builder__peak {
    width: 0.8em;
    height: 0.7em;
    background: var(--region-color);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .builder__name {
    color: var(--c-link);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: var(--line-hair);
    text-underline-offset: 0.15em;
  }
  .builder__link:hover .builder__name,
  .builder__link:focus-visible .builder__name {
    text-decoration-thickness: var(--line-edge);
  }
  .builder__city {
    grid-column: 2;
    color: var(--c-text-dim);
    font-size: var(--t-step--1);
  }

  /* The line opens over the next row, so nothing below moves (CLS). */
  .builder__line {
    position: absolute;
    inset-inline: 0;
    top: calc(100% - var(--s-2));
    z-index: 2;
    padding: var(--s-2) var(--s-3);
    border-top: var(--line-bold) solid var(--region-color);
    border-radius: 0 0 var(--r-card) var(--r-card);
    background: var(--c-surface);
    box-shadow: var(--sh-edge);
    color: var(--c-text);
    font-size: var(--t-step--1);
    line-height: 1.4;
    opacity: 0;
    visibility: hidden;
    translate: 0 calc(-1 * var(--s-1));
    transition:
      opacity 120ms ease-out,
      translate 120ms ease-out,
      visibility 0s linear 120ms;
    pointer-events: none;
  }
  .builder:hover .builder__line,
  .builder:focus-within .builder__line,
  .builder[data-open] .builder__line {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition-delay: 0s;
  }
  .builders__list[data-dismissed] .builder .builder__line {
    opacity: 0;
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .builder__line {
      transition: none;
      translate: none;
    }
  }

  .builders__more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin: var(--s-4) 0 0;
  }
  .builders__more a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-tap);
    font-weight: 700;
  }

  @media (max-width: 960px) {
    .builders__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .builders__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
