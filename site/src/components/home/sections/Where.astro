---
// Where: the statewide map as its drawing over shaded relief (ColoradoMap,
// live={false}: no MapLibre here, for the 75 KB JavaScript goal), each zone
// the entrance to its region (step W2). Hover, focus or tap on a zone lifts
// it and makes it glow; keyboard focus also shows a card with the region's
// crest, name and three counts. The table beside the map holds the same crest,
// name and counts, so a phone, a pointer or a screen reader gets all of it.
// The counts are frozen at build time, so the table says the build's date in
// Denver time, and the events column says its seven days. Counts come from zone-counts.ts,
// in the regions' fixed data order: regions are equals, never ranked.
import { brandArt } from "../../art/art-assets";
import { regionCrestKey } from "../../art/keepers";
import ColoradoMap from "../../map/ColoradoMap.astro";
import { COUNT_LABELS, zoneCounts } from "../../map/zone-counts";
import { REGION_COLORS } from "../../../lib/regions/map";
import { CALENDAR_TIMEZONE } from "../../info/links";

const now = new Date();
const zones = await zoneCounts(now);
const asOf = new Intl.DateTimeFormat("en-US", { timeZone: CALENDAR_TIMEZONE, month: "short", day: "numeric", year: "numeric" }).format(now);
const asOfDay = new Intl.DateTimeFormat("en-CA", { timeZone: CALENDAR_TIMEZONE }).format(now);
const rows = zones.map((z) => {
  const crest = brandArt(regionCrestKey(z.id));
  if (!crest) throw new Error(`no crest for region "${z.id}"; add it to brand.lock.json`);
  return { ...z, crest };
});
---

<section class="section section--lit" aria-labelledby="where">
  <div class="wrap where">
    <div class="where__copy">
      <h2 id="where">Three regions along the Front Range</h2>
      <table class="zones" data-zone-counts data-as-of={now.toISOString()}>
        <caption class="visually-hidden">Each region's counts</caption>
        <thead>
          <tr>
            <th scope="col">Region</th>
            {COUNT_LABELS.map(([key, label]) => <th scope="col" data-count={key}>{label}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr data-zone-row={r.id} style={`--region-color: ${REGION_COLORS[r.id]}`}>
                <th scope="row">
                  <a class="region-link" href={`/regions/${r.id}/`}>
                    <img class="zones__crest" src={r.crest.src} srcset={r.crest.srcset} sizes="40px" width="40" height="40" alt="" loading="lazy" decoding="async" />
                    <span class="region-link__name">{r.name}</span>
                  </a>
                </th>
                {COUNT_LABELS.map(([key]) => <td data-count={key}>{r[key]}</td>)}
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="zones__as-of meta">As of <time datetime={asOfDay}>{asOf}</time>, Denver time.</p>
    </div>
    <ColoradoMap id="home-map" live={false} caption="" zones={zones} />
  </div>
</section>

<script>
  // Escape closes a zone's card (hover content must be dismissible); the next
  // pointer move onto the map or focus inside it lets the cards show again.
  const map = document.getElementById("home-map");
  if (map) {
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") map.setAttribute("data-dismissed", "");
    });
    const reopen = () => map.removeAttribute("data-dismissed");
    map.addEventListener("pointerover", reopen);
    map.addEventListener("focusin", reopen);
  }
</script>

<style>
  .where {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--s-6);
    align-items: center;
  }
  .zones__as-of {
    margin: var(--s-1) 0 0;
  }
  .zones {
    width: 100%;
    margin: var(--s-4) 0 0;
    border-collapse: separate;
    border-spacing: 0 var(--s-2);
    font-variant-numeric: tabular-nums;
  }
  .zones thead th {
    padding: 0 var(--s-2);
    color: var(--c-text-dim);
    font-size: var(--t-step--1);
    font-weight: 400;
    line-height: 1.2;
    text-align: end;
    vertical-align: bottom;
  }
  .zones thead th:first-child {
    text-align: start;
  }
  .zones tbody > tr > * {
    padding: var(--s-2);
    background: var(--c-surface);
  }
  .zones tbody th {
    padding-inline-start: 0;
    border-left: var(--line-bold) solid var(--region-color);
    border-radius: var(--r-card) 0 0 var(--r-card);
    text-align: start;
    font-weight: 400;
  }
  .zones tbody td {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-step-1);
    text-align: end;
  }
  .zones tbody td:last-child {
    border-radius: 0 var(--r-card) var(--r-card) 0;
  }
  .region-link {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--size-tap);
    padding-inline-start: var(--s-2);
    color: var(--c-text);
    text-decoration: none;
  }
  .zones__crest {
    flex: none;
    width: 40px;
    height: 40px;
  }
  .region-link__name {
    font-weight: 700;
  }
  .region-link:hover .region-link__name,
  .region-link:focus-visible .region-link__name {
    text-decoration: underline;
    text-decoration-thickness: var(--line-edge);
  }

  @media (max-width: 760px) {
    .where {
      grid-template-columns: 1fr;
    }
  }
  /* At phone width the crest sits above the name, so four columns fit 375 px. */
  @media (max-width: 420px) {
    .region-link {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-1);
    }
  }
</style>
