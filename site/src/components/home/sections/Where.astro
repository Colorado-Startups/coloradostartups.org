---
// Where: the statewide map as its drawing over shaded relief (ColoradoMap,
// live={false}: no MapLibre here, for the 75 KB JavaScript goal), each zone
// the entrance to its region (step W2). Hover, focus or tap on a zone lifts
// it and makes it glow; keyboard focus also shows a card with the region's
// crest, name and three counts. The table beside the map holds the same crest,
// name and counts, so a phone, a pointer or a screen reader gets all of it.
// The counts are frozen at build time, so the table says the build's date in
// Denver time, and the events column says its seven days. Counts come from zone-counts.ts,
// in the regions' fixed data order: regions are equals, never ranked.
// A click on a zone or on a region's row counts as map_region_open (step
// M1c): "home-map" on the map, "home-map-list" in the table.
//
// Since 2026-11-16 this band comes right after the hero, so the map is in the
// first screen (Paul: "The homepage should lead with the Colorado map too").
// The map is the page's first image and its LCP: `priority` loads its relief
// eagerly, at high fetch priority, and the map comes before the table in the
// HTML, so no crest is fetched ahead of it. On a laptop the map takes the
// left column, and the heading and the table the right; on a phone or a
// tablet the heading comes first, then the map, then the table.
import { brandArt } from "../../art/art-assets";
import { regionCrestKey } from "../../art/keepers";
import ColoradoMap from "../../map/ColoradoMap.astro";
import { COUNT_LABELS, zoneCounts } from "../../map/zone-counts";
import { REGION_COLORS } from "../../../lib/regions/map";
import { trackAttrs } from "../../../lib/track-attrs";
import { CALENDAR_TIMEZONE } from "../../info/links";

// The map's column: up to 960 px, the whole .wrap (100vw less two 24 px
// gutters); past it, 13 of 23 parts of .wrap (at most 1180 px) less the 48 px
// gap, so 640 px at the widest, the relief's 640w file on a 1x laptop. Between
// 960 and 1228 px, (100vw - 96px) * 13 / 23 is rounded up to
// calc(57vw - 3.5rem), 2 to 4 px over, so a browser never picks a file
// narrower than the map draws (test/dom/home/map-first.test.ts). `sizes`
// cannot read CSS variables, so it uses rem (16 px).
const MAP_SIZES = "(max-width: 60rem) calc(100vw - 3rem), (max-width: 76.75rem) calc(57vw - 3.5rem), 40rem";

const now = new Date();
const zones = await zoneCounts(now);
const asOf = new Intl.DateTimeFormat("en-US", { timeZone: CALENDAR_TIMEZONE, month: "short", day: "numeric", year: "numeric" }).format(now);
const asOfDay = new Intl.DateTimeFormat("en-CA", { timeZone: CALENDAR_TIMEZONE }).format(now);
const rows = zones.map((z) => {
  const crest = brandArt(regionCrestKey(z.id));
  if (!crest) throw new Error(`no crest for region "${z.id}"; add it to brand.lock.json`);
  return { ...z, crest };
});
---

<section class="section section--lit where-band" aria-labelledby="where">
  <div class="wrap where">
    <h2 class="where__title" id="where">Three regions along the Front Range</h2>
    <div class="where__map">
      <ColoradoMap id="home-map" live={false} caption="" zones={zones} sizes={MAP_SIZES} priority where="home-map" />
    </div>
    <div class="where__list">
      <table class="zones" data-zone-counts data-as-of={now.toISOString()}>
        <caption class="visually-hidden">Each region's counts</caption>
        <thead>
          <tr>
            <th scope="col">Region</th>
            {COUNT_LABELS.map(([key, label]) => <th scope="col" data-count={key}>{label}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr data-zone-row={r.id} style={`--region-color: ${REGION_COLORS[r.id]}`}>
                <th scope="row">
                  <a class="region-link" href={`/regions/${r.id}/`} {...trackAttrs("map_region_open", { where: "home-map-list", region: r.id })}>
                    <img class="zones__crest" src={r.crest.src} srcset={r.crest.srcset} sizes="40px" width="40" height="40" alt="" loading="lazy" decoding="async" />
                    <span class="region-link__name">{r.name}</span>
                  </a>
                </th>
                {COUNT_LABELS.map(([key]) => <td data-count={key}>{r[key]}</td>)}
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="zones__as-of meta">As of <time datetime={asOfDay}>{asOf}</time>, Denver time.</p>
    </div>
  </div>
</section>

<script>
  // Escape closes a zone's card (hover content must be dismissible); the next
  // pointer move onto the map or focus inside it lets the cards show again.
  const map = document.getElementById("home-map");
  if (map) {
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") map.setAttribute("data-dismissed", "");
    });
    const reopen = () => map.removeAttribute("data-dismissed");
    map.addEventListener("pointerover", reopen);
    map.addEventListener("focusin", reopen);
  }
</script>

<style>
  /* Close under the hero, on the same ground, so the two read as one first
     screen. */
  .where-band {
    padding-block: var(--s-4) var(--s-8);
  }
  /* A phone or a tablet: the heading, the map right under it, then the
     table. */
  .where {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "title"
      "map"
      "list";
    gap: 0 var(--s-7);
    align-items: start;
  }
  .where__title {
    grid-area: title;
    margin-bottom: var(--s-3);
  }
  .where__map {
    grid-area: map;
  }
  .where__list {
    grid-area: list;
    margin-top: var(--s-4);
  }
  /* A laptop: map left, heading and table right. The map's column is 13 of
     23 parts, the width MAP_SIZES assumes. The table needs about 400 px with
     each crest beside its name and 344 px with it above (dev check,
     2026-11-16), so two columns start past 960 px, where the table's column
     is 376 px, and the crest sits above the name up to 1152 px. A media query
     cannot read CSS variables: 60rem is 960 px. */
  @media (min-width: 60.0625rem) {
    .where {
      grid-template-columns: minmax(0, 13fr) minmax(0, 10fr);
      grid-template-areas:
        "map title"
        "map list";
      grid-template-rows: auto 1fr;
    }
    .where__list {
      margin-top: 0;
    }
  }
  @media (min-width: 60.0625rem) and (max-width: 72rem) {
    .region-link {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-1);
    }
  }
  .zones__as-of {
    margin: var(--s-1) 0 0;
  }
  .zones {
    width: 100%;
    margin: 0;
    border-collapse: separate;
    border-spacing: 0 var(--s-2);
    font-variant-numeric: tabular-nums;
  }
  .zones thead th {
    padding: 0 var(--s-2);
    color: var(--c-text-dim);
    font-size: var(--t-step--1);
    font-weight: 400;
    line-height: 1.2;
    text-align: end;
    vertical-align: bottom;
  }
  .zones thead th:first-child {
    text-align: start;
  }
  .zones tbody > tr > * {
    padding: var(--s-2);
    background: var(--c-surface);
  }
  .zones tbody th {
    padding-inline-start: 0;
    border-left: var(--line-bold) solid var(--region-color);
    border-radius: var(--r-card) 0 0 var(--r-card);
    text-align: start;
    font-weight: 400;
  }
  .zones tbody td {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-step-1);
    text-align: end;
  }
  .zones tbody td:last-child {
    border-radius: 0 var(--r-card) var(--r-card) 0;
  }
  .region-link {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--size-tap);
    padding-inline-start: var(--s-2);
    color: var(--c-text);
    text-decoration: none;
  }
  .zones__crest {
    flex: none;
    width: 40px;
    height: 40px;
  }
  .region-link__name {
    font-weight: 700;
  }
  .region-link:hover .region-link__name,
  .region-link:focus-visible .region-link__name {
    text-decoration: underline;
    text-decoration-thickness: var(--line-edge);
  }

  /* At phone width the crest sits above the name and the cells pad 4 px a
     side, not 8, so four columns fit inside 375 px's 327 px .wrap (352 px at
     8 px, which ran into the right gutter; dev check, 2026-11-16). */
  @media (max-width: 420px) {
    .region-link {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-1);
      padding-inline-start: var(--s-1);
    }
    .zones thead th,
    .zones tbody > tr > * {
      padding-inline: var(--s-1);
    }
    .zones tbody th {
      padding-inline-start: 0;
    }
  }
</style>
