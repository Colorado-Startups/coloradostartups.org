---
// Where: the statewide map as its drawing over shaded relief (ColoradoMap,
// live={false}: no MapLibre here, for the 75 KB JavaScript goal), each zone
// a link to its region, and a chip per region.
import { REGION_COLORS } from "../../../lib/regions/map";
import { REGIONS } from "../../../lib/regions/match";
import ColoradoMap from "../../map/ColoradoMap.astro";
---

<section class="section section--lit" aria-labelledby="where">
  <div class="wrap where">
    <div class="where__copy">
      <h2 id="where">Three regions along the Front Range</h2>
      <ul class="region-links" role="list">
        {
          REGIONS.map((r) => (
            <li>
              <a class="region-link" href={`/regions/${r.id}/`} style={`--region-color: ${REGION_COLORS[r.id]}`}>
                <span class="region-link__swatch" aria-hidden="true" />
                <span class="region-link__name">{r.name}</span>
                <span class="region-link__cities">{r.cities.slice(0, 2).join(" · ")}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <ColoradoMap id="home-map" live={false} caption="" />
  </div>
</section>

<style>
  .where {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--s-6);
    align-items: center;
  }
  .region-links {
    display: grid;
    gap: var(--s-2);
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .region-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-3);
    min-height: var(--size-tap);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-card);
    background: var(--c-surface);
    color: var(--c-text);
    text-decoration: none;
  }
  .region-link__swatch {
    width: 14px;
    height: 14px;
    border-radius: var(--r-chisel);
    background: var(--region-color);
  }
  .region-link__name {
    font-weight: 700;
  }
  .region-link__cities {
    margin-left: auto;
    color: var(--c-text-dim);
    font-size: var(--t-step--1);
  }
  .region-link:hover .region-link__name,
  .region-link:focus-visible .region-link__name {
    text-decoration: underline;
  }

  /* A list gets the reading measure by default (global.css); this one is a grid. */
  .region-links {
    max-width: none;
  }

  @media (max-width: 760px) {
    .where {
      grid-template-columns: 1fr;
    }
  }
</style>
