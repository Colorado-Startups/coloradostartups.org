---
// Home's first section: the name, and one gold action, Join the Slack, with
// the LinkedIn Group second. Join the Slack opens a Google Form, and the note
// under it says so (#128). Both come from lib/communitas/join.ts, which the
// doors in Pick your door reuse.
//
// The statewide map comes right under it, in the Where band (Paul,
// 2026-11-16: "The homepage should lead with the Colorado map too"), and its
// relief is the page's first image. The two stay separate bands: one band
// with all of it would hold 71 words (this band's 23 and the map band's 54 in
// CI on 2026-11-16, less the map band's heading), and the cap is 60 a band
// (home-budget.test.ts). So this band is short: on a laptop the name and the
// buttons share one row, and the map fills most of the first screen below.
// Golden's painting led here until then; it is an accent in the Keepers band
// now, at the end of the page.
import { WAYS_IN } from "@cs/shared";

import { SLACK_JOIN } from "../../../lib/communitas/join";
import Button from "../../ui/Button.astro";
---

<section class="hero" aria-labelledby="home-title">
  <div class="wrap hero__row">
    <div class="hero__name">
      <h1 id="home-title">Colorado Startups</h1>
      <p class="lede">Meet the founders building companies in Colorado.</p>
    </div>
    <div class="hero__join">
      <div class="btn-row">
        <Button size="lg" href={SLACK_JOIN.href} aria-describedby={SLACK_JOIN.noteId}>{SLACK_JOIN.label}</Button>
        <Button size="lg" variant="secondary" href={WAYS_IN["linkedin-group"]}>Join the LinkedIn Group</Button>
      </div>
      <p class="meta" id={SLACK_JOIN.noteId}>{SLACK_JOIN.note}</p>
    </div>
  </div>
</section>

<style>
  /* The daylight ground, as the map band below it, so the first screen reads
     as one: the name and the buttons on top, Colorado under them. */
  .hero {
    padding-block: var(--s-6) var(--s-4);
    background: var(--c-ground);
  }
  .hero__row {
    display: grid;
    gap: var(--s-4) var(--s-7);
    align-items: end;
  }
  .hero h1 {
    margin: 0 0 var(--s-3);
  }
  .hero .lede {
    margin: 0;
  }
  .hero .meta {
    margin: var(--s-3) 0 0;
  }
  /* A laptop: the buttons stack in a column beside the name, one width, so
     the band stays one row tall and the map starts high on the screen.
     A media query cannot read CSS variables: 47.5rem is the 760 px breakpoint. */
  @media (min-width: 47.5rem) {
    .hero__row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .hero__join .btn-row {
      flex-direction: column;
    }
  }
</style>
