---
// One Why Colorado panel: the region's map, three sourced figures, and two
// ways on, to the region and to its Leaderboard honorees.
//
// The header is the real map of the region (ColoradoMap's thumbnail): its
// line along its roads, its cities, and where it sits in the state. It links
// to the region's page, where the region's painting is the full art.
import { REGION_COLORS } from "../../lib/regions/map";
import ColoradoMap from "../map/ColoradoMap.astro";
import type { Theme } from "./home-data";
import StatTile from "./StatTile.astro";

interface Props {
  theme: Theme;
}
const { theme } = Astro.props;
const id = `theme-${theme.region}`;
---

<article class="theme panel" aria-labelledby={id} style={`--theme-color: ${REGION_COLORS[theme.region]}`}>
  <ColoradoMap id={`theme-map-${theme.region}`} zone={theme.region} variant="thumb" label={`Map of ${theme.regionName}: open its page`} />
  <div class="theme__body">
    <h3 id={id}>{theme.title}</h3>
    <div class="theme__tiles">
      {theme.tiles.map((t) => <StatTile {...t} />)}
    </div>
    <p class="theme__links">
      <a class="tap-target" href={`/regions/${theme.region}/`}>Explore {theme.regionName}</a>
      <a class="tap-target" href="/leaderboard/">{theme.honorees} of the 2026 honorees</a>
    </p>
  </div>
</article>

<style>
  .theme {
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 0;
    overflow: hidden;
    border-top: var(--line-bold) solid var(--theme-color);
  }
  .theme__body {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding: var(--s-5);
  }
  .theme__body h3,
  .theme__body p {
    margin: 0;
  }
  .theme__tiles {
    display: grid;
    gap: var(--s-4);
  }
  .theme__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
  }
</style>
