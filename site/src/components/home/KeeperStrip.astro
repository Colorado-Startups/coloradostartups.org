---
// The keepers on the home page: one slim strip, last on the page. It is an AI
// disclosure surface (.claude/rules/ai-disclosure.md): the line names each
// keeper as an AI agent, and each portrait's alt text, from portraitAlt(),
// says "AI agent" too. Keepers come from data/team/dwarves.yaml in file order.
import { getCollection } from "astro:content";

import { portraitAlt } from "../art/keepers";
import Portrait from "../art/Portrait.astro";
import { inFileOrder } from "../team/order";

const keepers = inFileOrder("dwarves", (await getCollection("dwarves")).map((k) => k.data));
const names = keepers.map((k) => k.name);
const list = `${names.slice(0, -1).join(", ")} and ${names.at(-1)}`;
---

<div class="keeper-strip" data-keeper-strip>
  <ul class="keeper-strip__faces" role="list">
    {
      keepers.map((k) => (
        <li data-face={k.id}>
          <Portrait id={k.id} size="small" alt={portraitAlt(k.id, k.name, k.title)} sizes="56px" />
        </li>
      ))
    }
  </ul>
  <p><strong>{list} are AI agents.</strong> People run the community.</p>
  <a class="tap-target" href="/team/">Meet the team</a>
</div>

<style>
  .keeper-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
  }
  .keeper-strip p {
    flex: 1 1 24rem;
    margin: 0;
  }
  .keeper-strip__faces {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Portrait's small size draws the round, gold-ringed face; this sets its size. */
  .keeper-strip__faces li {
    --portrait-small: 56px;
  }
  .keeper-strip__faces li + li {
    margin-left: var(--s-2);
  }
</style>
