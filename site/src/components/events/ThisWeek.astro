---
// This week (engagement plan steps P2a and P2b): the next three events with a
// countdown, and the weekly thread rhythm in the Slack and the LinkedIn Group.
// Home places it statewide (home/sections/ThisWeek.astro); each region page
// places it with `region` (regions/sections/ThisWeek.astro).
//
// Events. Every event that had not ended at build time is in the HTML, up to
// KEEP; the first COUNT show. On the visitor's clock the script hides what
// ended and rewrites each countdown (this-week.ts), so a page built days ago
// still counts from today. Without JavaScript the build-time list stands.
// Titles link the event calendar, which carries the host's own link: home
// links only a few known outside hosts (site/test/dom/l1/hall.test.ts). A long
// title is cut on screen; the link's aria-label carries it in full, with the
// date.
//
// Region. Each event carries data-event-region with the region placeRegion()
// gives it, the rule the region counts and /data/events.json use
// (zone-counts.ts). Online and unlisted places carry none. Not data-region: on
// home that attribute marks a hall card (site/test/dom/l1/hall.test.ts). With
// `region`, the strip lists only the events placed in that region, and its
// links go to the event list filtered to it. A link on to that list shows
// while fewer than COUNT events show; an empty list says so in one line.
//
// Slack. One join link (join.ts), described by the page's own visible note:
// home's hero renders SLACK_JOIN.noteId, and a region page passes its hero's.
// Both join links count as join_click (step M1c): "home-week" on home,
// "regions-<id>-week" on a region page.
//
// Your region (step W8). On home, a region picked on this device puts its
// events first, and a hidden line comes up to say so, with a Show all button
// (initRegionFirst in this-week.ts). With no pick the build's order stands.
//
import { WAYS_IN, type Region } from "@cs/shared";
import { getCollection } from "astro:content";

import { clampWords } from "../../lib/communitas/doors";
import { SLACK_JOIN } from "../../lib/communitas/join";
import { placeRegion } from "../../lib/data/open-data";
import { ELSEWHERE, REGIONS } from "../../lib/regions/match";
import { joinAttrs } from "../../lib/track-attrs";
import { countdown } from "./countdown";
import { dateParts, endsAt, SNAPSHOT, startsAt, upcomingEvents } from "./events";
import { filterQuery } from "./list-filter";

interface Props {
  /** A region page's strip: only the events placed in this region. Home passes none. */
  region?: Region;
  /** The id of the visible note that says where the Slack link goes. */
  slackNoteId?: string;
}

const { region, slackNoteId = SLACK_JOIN.noteId } = Astro.props;

/** Events that show, and how many wait hidden behind them for prune.ts. */
const COUNT = 3;
const KEEP = 9;
/** Words of an event title on screen, so the strip stays inside its word cap. */
const TITLE_WORDS = 5;

const now = Date.now();
const placed = upcomingEvents(SNAPSHOT, new Date(now)).map((event) => ({ event, place: placeRegion(event.location) }));
const events = (region ? placed.filter((p) => p.place === region.id) : placed).slice(0, KEEP);
/** The band, as join_click's `where`. */
const where = region ? `regions-${region.id}-week` : "home-week";
/** Where the titles go: the event calendar, or on a region page its list filtered to the region. */
const eventsHref = region ? `${WAYS_IN.events}${filterQuery({ region: region.id, when: "", type: "" })}#all-events` : WAYS_IN.events;
/** Each region's name by id, for home's "Showing <region> first" line. */
const regionNames = JSON.stringify(Object.fromEntries(REGIONS.map((r) => [r.id, r.name])));

const DAYS = [
  { day: "mon", label: "Mon" },
  { day: "wed", label: "Wed" },
  { day: "fri", label: "Fri" },
] as const;
const openers = (await getCollection("threads")).map((entry) => entry.data);
const rhythm = DAYS.flatMap(({ day, label }) => {
  const opener = openers.find((t) => t.day === day);
  return opener ? [{ day, label, title: opener.title }] : [];
});
---

<section class="section this-week" aria-labelledby="this-week">
  <div class="wrap">
    <h2 id="this-week">This week</h2>
    <div class="this-week__grid">
      <div class="this-week__events" data-this-week data-count={COUNT}>
        {
          events.length > 0 && (
            <ol class="this-week__list" role="list">
              {events.map(({ event, place }, i) => {
                const date = dateParts(event);
                const start = startsAt(event);
                return (
                  <li
                    data-ends={new Date(endsAt(event)).toISOString()}
                    data-starts={new Date(start).toISOString()}
                    data-event-region={place === ELSEWHERE ? undefined : place}
                    hidden={i >= COUNT}
                  >
                    <time class="this-week__when" datetime={event.start} data-countdown>
                      {countdown(start, now)}
                    </time>
                    <a href={eventsHref} aria-label={`${event.title}, ${date.weekday} ${date.month} ${date.day}`}>
                      {clampWords(event.title, TITLE_WORDS)}
                    </a>
                  </li>
                );
              })}
            </ol>
          )
        }
        <p class="this-week__empty" data-events-empty hidden={events.length > 0}>
          {region ? "No events listed here yet." : <a href={WAYS_IN.events}>See the event calendar</a>}
        </p>
        {
          !region && (
            <p class="this-week__first" data-region-first data-region-names={regionNames} hidden>
              <span data-region-first-text>Showing your region first.</span>{" "}
              <button type="button" class="btn btn--quiet" data-region-first-toggle>
                Show all
              </button>
            </p>
          )
        }
        {
          region && (
            <p class="this-week__more" data-events-more hidden={events.length >= COUNT}>
              <a href={eventsHref} data-link="region-events">
                Events in {region.name}
              </a>
            </p>
          )
        }
      </div>
      <div class="this-week__threads" data-threads>
        <ul class="this-week__list" role="list">
          {
            rhythm.map((t) => (
              <li data-day={t.day}>
                <span class="this-week__when">{t.label}</span>
                <span>{t.title}</span>
              </li>
            ))
          }
        </ul>
        <p class="this-week__ways">
          Weekly in the <a href={SLACK_JOIN.href} aria-describedby={slackNoteId} data-link="slack" {...joinAttrs(where)}>Slack</a> and the{" "}
          <a href={WAYS_IN["linkedin-group"]} rel="noopener" data-link="linkedin-group" {...joinAttrs(where, "linkedin-group")}>LinkedIn Group</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initRegionFirst, refreshBand } from "./this-week";

  const now = Date.now();
  for (const root of document.querySelectorAll<HTMLElement>("[data-this-week]")) {
    refreshBand(root, now);
    initRegionFirst(root);
  }
</script>

<style>
  .this-week h2 {
    margin-bottom: var(--s-5);
  }
  .this-week__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--s-4);
  }
  .this-week__events,
  .this-week__threads {
    padding: var(--s-3) var(--s-4);
    border-top: var(--line-bold) solid var(--c-accent);
    border-radius: var(--r-chisel);
    background: var(--c-ground);
  }
  .this-week__list,
  .this-week__empty {
    list-style: none;
    max-width: none;
    margin: 0;
    padding: 0;
  }
  .this-week__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-3);
    min-height: var(--size-tap);
  }
  /* display: flex would beat the hidden attribute's own rule. */
  .this-week__list li[hidden],
  .this-week__empty[hidden],
  .this-week__more[hidden],
  .this-week__first[hidden] {
    display: none;
  }
  .this-week__when {
    padding: var(--s-1) var(--s-2);
    border-radius: var(--r-chisel);
    background: var(--c-surface-2);
    font-weight: 700;
    white-space: nowrap;
  }
  .this-week a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-tap);
    overflow-wrap: anywhere;
    font-weight: 700;
  }
  .this-week__ways,
  .this-week__more,
  .this-week__first {
    margin: var(--s-2) 0 0;
  }
  .this-week__first {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-2);
    max-width: none;
  }
</style>
