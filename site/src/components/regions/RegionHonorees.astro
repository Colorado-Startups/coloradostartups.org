---
// A region's Leaderboard honorees, short: how many of the latest edition are
// headquartered there, six of them across sectors (one per sector in turn,
// the most common sector first, A to Z inside each), and a link to see all of
// them on the Leaderboard. A listing recognizes founders and their teams; this
// list carries no investing language (decision 17 and the Leaderboard purpose
// limit). Public notes come from L2's notes.yaml, so an announced acquisition
// shows here too. Owner: L8.
import type { Company, Edition, Region } from "@cs/shared";

import { countBy } from "../../lib/leaderboard/board";
import { COMPANY_NOTES } from "../../lib/leaderboard/notes";
import { regionFilterHref, spread } from "../../lib/regions/page";

interface Props {
  region: Region;
  edition: Edition;
  /** The region's honorees, A to Z. */
  companies: readonly Company[];
}

/** Six fill whole rows at one, two and three columns. */
const SHOWN = 6;

const { region, edition, companies } = Astro.props;
const sectors = countBy(companies, (c) => c.sector).map((s) => s.key);
const shown = spread(companies, (c) => c.sector, SHOWN, sectors);
---

<div class="region-honorees" data-region-honorees>
  <p class="tally">
    <span class="tally__n">{companies.length}</span>
    <span>of the {edition.title} are headquartered in {region.name}</span>
  </p>
  {
    shown.length > 0 && (
      <ul class="picks">
        {shown.map((c) => (
          <li data-id={c.id} data-hq={c.hq_city}>
            <span class="hall-badge">{c.sector}</span>
            <a href={c.website}>{c.name}</a>
            <span class="meta">{c.hq_city}</span>
            {COMPANY_NOTES[c.id] && <span class="meta note">{COMPANY_NOTES[c.id]}</span>}
          </li>
        ))}
      </ul>
    )
  }
  <p class="see-all">
    <a class="btn btn--stone" href={regionFilterHref("/leaderboard/", region.id)} data-see-all>
      {companies.length > 0 ? `See all ${companies.length} honorees` : "See the Leaderboard"}
    </a>
    <a class="tap-target" href="/leaderboard/nominate/">Nominate a company</a>
  </p>
  <p class="meta">As of {edition.published}. Congratulations to the founders and teams building them.</p>
</div>

<style>
  .tally {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0 0 var(--s-4);
  }
  .tally__n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-step-3);
    line-height: 1;
  }
  .picks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--s-3);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }
  .picks li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-1);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-card);
    background: var(--c-surface);
    box-shadow: 0 0 0 var(--line-hair) var(--c-border);
  }
  .picks a {
    font-weight: 700;
  }
  .note {
    font-style: italic;
  }
  .see-all {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    margin: var(--s-5) 0 var(--s-3);
  }
</style>
