---
// A region's illustration slot: data/regions/<id>.yaml names its art, a brand
// v3 place painting such as brand/springs (scripts/brand/pull.mjs). L7's ArtImage finds it, lets Astro
// optimize it, and shows a placeholder tinted with the region's color until the
// file lands, so layout does not shift. The region page's hero gets a lantern
// glow; list cards stay still. Owner: L8; wired by L7 (lane/L7-wiring).
//
// A region with a brand clip (keepers.ts REGION_CLIP; brand v4.2.0: Photon
// Mountain) plays it over its hero painting: muted, looped, loaded only when
// the painting nears the screen, with a Pause button, and never under
// prefers-reduced-motion. The painting stays underneath as the image, its alt
// text and the no-JavaScript view; the clip is aria-hidden, since it is the
// same picture moving.
import type { Region } from "@cs/shared";

import { REGION_COLORS } from "../../lib/regions/map";
import ArtImage from "../art/ArtImage.astro";
import { REGION_CLIP, regionArtAlt, type RegionArtId } from "../art/keepers";

interface Props {
  region: Region;
  /** "hero" for the region page, "card" for the /regions/ list. */
  size?: "hero" | "card";
  /** Defaults to eager for a hero and lazy for a card; a card in the first screen passes "eager" (#258). */
  loading?: "eager" | "lazy";
  /** The drawn width, for a card in a grid other than the 17rem .hall-grid. */
  sizes?: string;
}

const { region, size = "card", loading, sizes } = Astro.props;
// The alt is the brand's plain caption (keepers.ts REGION_ART_ALT); no caller
// can blank it, and a region with no alt fails the build instead of rendering
// an empty one.
const alt = regionArtAlt(region.id);
const hero = size === "hero";
const clip = hero ? REGION_CLIP[region.id as RegionArtId] : undefined;

// `sizes` is the width the art really draws, so a phone picks the smallest
// file that still covers it. Both sit in .wrap (100vw less two 24 px
// gutters, at most 1180 px). A card sits in a .hall-grid of 17rem columns
// with 24 px gaps, inside a 2 px border on each side: one column below
// 616 px, two below 912 px, three from there. On the mobile lab's 412 px
// screen at 1.75x, a card draws 360 px wide, so it fetches the 640w file
// (58 KB) instead of the 800w (86 KB), and the hero the 640w instead of the
// 960w. The three cards load at once on a phone: the lazy two sit inside
// Chrome's lazy-load distance, so they share the bandwidth with the first.
const SIZES = {
  hero: "(max-width: 1227px) calc(100vw - 48px), 1180px",
  card: "(max-width: 615px) calc(100vw - 52px), (max-width: 911px) calc(50vw - 40px), 380px",
};
const art = {
  src: region.art,
  alt,
  aspect: hero ? "21 / 9" : "16 / 9",
  widths: hero ? [640, 960, 1280, 1920] : [400, 640, 800],
  sizes: sizes ?? SIZES[size],
  loading: loading ?? (hero ? ("eager" as const) : ("lazy" as const)),
  motion: hero ? ("glow" as const) : ("none" as const),
  label: "Illustration in progress",
  tint: REGION_COLORS[region.id],
  class: `region-art region-art--${size}`,
};
---

{
  clip ? (
    <div class="region-art__media">
      <ArtImage {...art} />
      <video class="region-art__clip" data-region-clip muted loop playsinline preload="none" aria-hidden="true">
        <source src={`/art/brand/${clip}.webm`} type="video/webm" />
        <source src={`/art/brand/${clip}.mp4`} type="video/mp4" />
      </video>
      <button type="button" class="region-art__toggle" data-clip-toggle>
        Pause
      </button>
    </div>
  ) : (
    <ArtImage {...art} />
  )
}

<script>
  // Play each clip while its painting is on screen; the button pauses it for good.
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const video of document.querySelectorAll<HTMLVideoElement>("[data-region-clip]")) {
      const media = video.parentElement!;
      const toggle = media.querySelector<HTMLButtonElement>("[data-clip-toggle]");
      let held = false;
      const play = () =>
        video
          .play()
          .then(() => (media.dataset.playing = "true"))
          .catch(() => undefined);
      new IntersectionObserver(
        ([entry]) => {
          if (held) return;
          if (entry?.isIntersecting) void play();
          else video.pause();
        },
        { threshold: 0.25 },
      ).observe(media);
      toggle?.addEventListener("click", () => {
        held = !video.paused;
        if (held) video.pause();
        else void play();
        toggle.textContent = held ? "Play" : "Pause";
      });
    }
  }
</script>

<style>
  /* ArtImage renders the <figure>. On the region page it gets the card radius
     and glow; in a Card's media slot the card's own frame does the rounding. */
  :global(.art-image.region-art--hero) {
    border-radius: var(--r-card);
    box-shadow: var(--sh-glow);
  }
  .region-art__media {
    position: relative;
    border-radius: var(--r-card);
    overflow: hidden;
  }
  .region-art__clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s;
  }
  .region-art__toggle {
    position: absolute;
    right: var(--s-2);
    bottom: var(--s-2);
    min-height: var(--size-tap);
    padding-inline: var(--s-3);
    border: 0;
    border-radius: var(--r-chisel);
    background: color-mix(in oklab, var(--c-night) 75%, transparent);
    color: var(--c-on-night);
    font: inherit;
    font-weight: 700;
    /* Not just see-through: hidden, so Tab never lands on it before the clip shows. */
    visibility: hidden;
  }
  .region-art__media[data-playing] .region-art__clip {
    opacity: 1;
  }
  .region-art__media[data-playing] .region-art__toggle {
    visibility: visible;
  }
  /* 21:9 shows the scene 327 by 140 px on a phone, a strip that loses its
     detail. 16:9 keeps it readable (#251). */
  @media (max-width: 760px) {
    :global(figure.art-image.region-art--hero) {
      aspect-ratio: 16 / 9;
    }
  }
</style>
