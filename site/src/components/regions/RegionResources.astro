---
// A region's Startup Resources, short: how many are based there, six of them,
// a link to see all of them in the directory, and each city's count as a link
// into the directory's city filter. The six are a newcomer's first stops: one
// per type in turn, in FIRST_STOPS order, a core city's ahead of a nearby
// town's. The directory has no ranking, so this order is the choice. The six
// are left out of the Pagefind index, so a search finds each resource once, on
// the directory. Owner: L8.
import type { Region, ResourceCard } from "@cs/shared";

import { cityLabel, TYPE_LABELS } from "../canvas/labels";
import { countBy } from "../../lib/leaderboard/board";
import { canvasCityHref, regionFilterHref, spread } from "../../lib/regions/page";

interface Props {
  region: Region;
  /** Active resources whose city maps to this region. */
  cards: readonly ResourceCard[];
  /** Active statewide resources, which serve every region. */
  statewide: number;
}

/** Six fill whole rows at one, two and three columns. */
const SHOWN = 6;
/** Where a founder new to the region starts: people first, then programs and places, then services. */
const FIRST_STOPS: readonly ResourceCard["type"][] = [
  "community",
  "accelerator",
  "coworking",
  "incubator",
  "university",
  "government",
  "nonprofit",
  "event",
  "education",
  "investor",
  "service-provider",
  "media",
  "tool",
  "other",
];

const { region, cards, statewide } = Astro.props;
const core = (c: ResourceCard) => (region.cities.includes(c.city) ? 0 : 1);
const shown = spread(
  [...cards].sort((a, b) => core(a) - core(b)),
  (c) => c.type,
  SHOWN,
  FIRST_STOPS,
);
const cities = countBy(cards, (c) => c.city);
---

<div class="region-resources" data-region-resources>
  <p class="tally">
    <span class="tally__n">{cards.length}</span>
    <span>{cards.length === 1 ? "resource" : "resources"} based in {region.name}</span>
  </p>
  {
    shown.length > 0 && (
      <ul class="picks" data-pagefind-ignore>
        {shown.map((card) => (
          <li data-id={card.id} data-city={card.city}>
            <span class="hall-badge">{TYPE_LABELS[card.type]}</span>
            <a href={card.url}>{card.name}</a>
            <span class="meta">{cityLabel(card.city)}</span>
          </li>
        ))}
      </ul>
    )
  }
  <p class="see-all">
    <a class="btn btn--stone" href={regionFilterHref("/ecosystem-canvas/", region.id)} data-see-all>
      {cards.length > 0 ? `See all ${cards.length} in ${region.name}` : "Browse Startup Resources"}
    </a>
  </p>
  <ul class="city-links" aria-label={`Startup Resources by city in ${region.name}`}>
    {
      cities.map((c) => (
        <li>
          <a class="tap-target" href={canvasCityHref(c.key)}>
            {cityLabel(c.key)} <span class="count">{c.count}</span>
          </a>
        </li>
      ))
    }
    {
      statewide > 0 && (
        <li>
          <a class="tap-target" href={canvasCityHref("statewide")} data-statewide>
            Statewide <span class="count">{statewide}</span>
          </a>
        </li>
      )
    }
  </ul>
</div>

<style>
  .tally {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0 0 var(--s-4);
  }
  .tally__n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-step-3);
    line-height: 1;
  }
  .picks,
  .city-links {
    padding: 0;
    list-style: none;
    max-width: none;
  }
  .picks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--s-3);
    margin: 0;
  }
  .picks li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-1);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-card);
    background: var(--c-ground);
    box-shadow: 0 0 0 var(--line-hair) var(--c-border);
  }
  .picks a {
    font-weight: 700;
  }
  .see-all {
    margin: var(--s-5) 0 var(--s-3);
  }
  .city-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-4);
    margin: 0;
  }
  .count {
    color: var(--c-text-dim);
  }
</style>
