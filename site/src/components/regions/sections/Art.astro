---
// The region's place painting and its four sourced figures (region-tiles.ts),
// inside Hero's section. Owner: L8.
//
// Step W3b: the painting's hotspots open real content. This file gathers it
// at build time with the helpers the region page already uses, and
// hotspots.ts shapes one card per hotspot: up to five Leaderboard honorees
// (across sectors, as RegionHonorees picks them), the next event on the
// calendar whose venue is in the region, three Startup Resources (the
// newcomer's first stops, as RegionResources picks them) and the
// organizer seat.
import { WAYS_IN, type Region } from "@cs/shared";
import { getCollection } from "astro:content";

import { activeCards } from "../../canvas/canvas-data";
import { cityLabel } from "../../canvas/labels";
import { SNAPSHOT, upcomingEvents, whenText } from "../../events/events";
import StatTile from "../../home/StatTile.astro";
import { takesApplications } from "../../positions/positions";
import { buildBoard, countBy, latestEdition } from "../../../lib/leaderboard/board";
import { REGIONS } from "../../../lib/regions/match";
import { firstStops, honoreesIn, inRegion, organizerFor, regionFilterHref, spread } from "../../../lib/regions/page";
import { seatPagePath } from "../../../lib/seats/page";
import { hotspotCards, CARD_COMPANIES, CARD_RESOURCES } from "../hotspots";
import RegionArt from "../RegionArt.astro";
import { regionTiles } from "../region-tiles";
import { eventCity } from "../tallies";

interface Props {
  region: Region;
  /** The build's clock, for the next event. */
  now?: Date;
}

const { region, now = new Date() } = Astro.props;
const regions = [...REGIONS];

const companies = (await getCollection("companies")).map((e) => e.data);
const edition = latestEdition((await getCollection("editions")).map((e) => e.data));
if (!edition) throw new Error("no Leaderboard edition in data/leaderboard/editions/");
const honorees = honoreesIn(
  region.id,
  buildBoard(edition, companies).map((row) => row.company),
  regions,
);
const sectors = countBy(honorees, (c) => c.sector).map((s) => s.key);

const next = inRegion(region.id, upcomingEvents(SNAPSHOT, now), eventCity, regions)[0];
const when = next ? whenText(next) : undefined;

const resources = inRegion(region.id, await activeCards(), (c) => c.city, regions);

const positions = (await getCollection("positions")).map((e) => e.data);
const people = (await getCollection("people")).map((e) => e.data);
const { position, holder } = organizerFor(region.id, positions, people);

const cards = hotspotCards({
  region,
  companies: spread(honorees, (c) => c.sector, CARD_COMPANIES, sectors),
  companiesTotal: honorees.length,
  companiesHref: regionFilterHref("/leaderboard/", region.id),
  event: next && when ? { title: next.title, url: next.url, when: `${when.day}, ${when.time}` } : undefined,
  eventsHref: WAYS_IN.events,
  resources: firstStops(region, resources, CARD_RESOURCES).map((c) => ({ ...c, city: cityLabel(c.city) })),
  resourcesTotal: resources.length,
  resourcesHref: regionFilterHref("/ecosystem-canvas/", region.id),
  seat: {
    title: position.title,
    open: position.status === "open",
    holder: holder?.name,
    // A seat that takes applications has its own page; otherwise the seat's card on this page.
    href: takesApplications(position) ? seatPagePath(position.id) : "#organizer",
  },
  seatsHref: "/get-involved/",
});
---

<RegionArt region={region} size="hero" hotspots={cards} />
<h2 class="visually-hidden">{region.name} in numbers</h2>
<div class="tiles" data-region-tiles>
  {regionTiles(region.id).map((t) => <StatTile {...t} />)}
</div>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--s-7);
    margin-top: var(--s-6);
  }
  @media (max-width: 760px) {
    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
