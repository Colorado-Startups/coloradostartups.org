---
// The Ask dialog (step K1): search the site, ask Resourcus, or copy a prompt
// for your own AI, from any page. The header's Search button and the "/" key
// open it (ask-dialog.ts). It ships inside a <template>, so its form and
// fields join the page only when a visitor opens it; the script copies it onto
// <body>. The search is a plain GET to /ask/?q=, the page that runs Pagefind.
// Resourcus is named with "an AI agent" wherever it appears
// (.claude/rules/ai-disclosure.md).
// Each way to ask counts as ask_used, where "ask-dialog" (step M1c): the
// Search button (pressing Enter in the box clicks it too) with kind "search",
// the Resourcus link with "resourcus", and Copy prompt with "copy".
import { trackAttrs } from "../../lib/track-attrs";
import AskAi from "../ai/AskAi.astro";

const where = "ask-dialog";
---

<template data-ask-template>
  <dialog class="ask-dialog" aria-labelledby="ask-dialog-title" closedby="any">
    <div class="ask-dialog__head">
      <h2 id="ask-dialog-title">Search or ask</h2>
      <form method="dialog">
        <button type="submit" class="btn btn--stone ask-dialog__close">Close</button>
      </form>
    </div>
    <form class="ask-dialog__search" action="/ask/" method="get" role="search" aria-label="Site">
      <label for="ask-dialog-q">Search the site</label>
      <div class="ask-dialog__row">
        <input id="ask-dialog-q" type="search" name="q" required autocomplete="off" enterkeyhint="search" />
        <button type="submit" class="btn btn--gold" {...trackAttrs("ask_used", { where, kind: "search" })}>Search</button>
      </div>
    </form>
    {/* WCAG 2.1.4: a one-key shortcut must be possible to turn off. Saved on this device. */}
    <p class="ask-dialog__key">
      <input id="ask-dialog-key" type="checkbox" checked data-ask-key-toggle />
      <label for="ask-dialog-key">Open search with the / key</label>
    </p>
    <p class="ask-dialog__resourcus">
      <a href="/ask/" {...trackAttrs("ask_used", { where, kind: "resourcus" })}>Ask Resourcus, an AI agent</a>, about Colorado's startup resources.
    </p>
    <div class="ask-dialog__ai">
      <AskAi subject="Colorado Startups" path="/" id="ask-dialog-ai" where={where} dialog />
    </div>
  </dialog>
</template>

<style is:global>
  /* Global, not scoped: the dialog is copied out of a <template> onto <body>.
     A stone tablet set down over the page, under the same lintel light. */
  .ask-dialog {
    width: min(100% - 2 * var(--s-4), 40rem);
    max-height: min(100% - 2 * var(--s-5), 48rem);
    margin: max(var(--s-5), 8vh) auto auto;
    padding: var(--s-5);
    color: var(--c-text);
    background:
      radial-gradient(60% 40% at 50% 0%, color-mix(in oklab, var(--c-accent) 10%, transparent), transparent 70%),
      var(--c-ground);
    border: var(--line-edge) solid var(--c-stone-edge);
    border-radius: var(--r-chisel);
    box-shadow:
      inset 0 3px 0 var(--c-accent),
      var(--sh-ledge);
  }
  .ask-dialog:modal {
    overscroll-behavior: contain;
  }
  .ask-dialog::backdrop {
    overflow: hidden;
    overscroll-behavior: contain;
    background: color-mix(in oklab, var(--c-text) 55%, transparent);
  }
  .ask-dialog__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .ask-dialog h2 {
    margin: 0;
  }
  .ask-dialog__search {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-5);
  }
  .ask-dialog__search label {
    font-weight: 700;
  }
  .ask-dialog__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .ask-dialog__row input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: var(--size-control);
    padding-inline: var(--s-3);
    font: inherit;
    color: var(--c-text);
    background: var(--c-surface);
    border: var(--line-edge) solid var(--c-border);
    border-radius: var(--r-chisel);
  }
  .ask-dialog__key {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--size-tap);
    margin: var(--s-3) 0 0;
    font-size: var(--t-step--1);
  }
  .ask-dialog__key input {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    accent-color: var(--c-accent-deep);
  }
  .ask-dialog__resourcus {
    margin: var(--s-5) 0 0;
  }
  .ask-dialog__ai {
    margin-top: var(--s-5);
    padding-top: var(--s-5);
    border-top: var(--line-hair) solid var(--c-rule);
  }
  /* The row's heading sits one step below the dialog's title. */
  .ask-dialog__ai h2 {
    font-size: var(--t-step-1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ask-dialog[open] {
      animation: ask-dialog-in 160ms ease-out;
    }
    @keyframes ask-dialog-in {
      from {
        opacity: 0;
        translate: 0 -8px;
      }
    }
  }
</style>
