---
// The body of one guide (step F of the redesign, 2026-11-15): the answer
// first, then the answer as a chart, one row per part, each linked to the
// Startup Resources view that holds its listings (lib/guides/browse.ts), and
// the guide's picture. Then five records to start with, the calendar's next
// events on the events guide, and the other guides. Owner: L23; L32 added the
// calendar's next events and grouped the other guides. The long lists that
// used to follow became the chart's links.
//
// The five records stay out of the Pagefind index, so a search finds each
// resource once, on the directory (the same choice RegionResources makes).
// The answer and the headings stay in the index.
import type { GuideRow } from "../../lib/guides/browse";
import { guidePath, type AsOf, type Guide, type GuideMeta, type GuideRecord, type GuideSlug } from "../../lib/guides/guides";
import ArtImage from "../art/ArtImage.astro";
import { GUIDE_ART_IMAGE, guideArt } from "./guide-art";
import GuideChart from "./GuideChart.astro";
import GuideItem from "./GuideItem.astro";
import GuideText from "./GuideText.astro";
import GuideUpcoming from "./GuideUpcoming.astro";

interface Props {
  guide: Guide;
  /** The chart's rows, in page order (browse.ts guideRows). */
  rows: readonly GuideRow[];
  /** The records the page lists in full (browse.ts startWith). */
  start: readonly GuideRecord[];
  /** Where "See more" goes: the Startup Resources view that holds every listing. */
  browse: string;
  /** The day the lists were built, for the chart's caption. */
  date: AsOf;
  /** The other guides by group, for the links at the foot of the page. */
  others: readonly { heading: string; guides: readonly GuideMeta[] }[];
}

const { guide, rows, start, browse, date, others } = Astro.props;
// Guides whose parts come in order: the steps to start a company, and the
// rounds of funding.
const STEPS: readonly GuideSlug[] = ["start-a-company-in-colorado", "funding-programs"];
const art = guideArt(guide.slug);
// The bands alternate down the page; the next events, when shown, take the first.
const offset = guide.upcoming ? 1 : 0;
---

<section class="section section--band" aria-labelledby="guide-title">
  <div class="wrap stack">
    <nav aria-label="Breadcrumb" class="crumbs">
      <ol>
        <li><a href="/guides/">Guides</a></li>
        <li aria-current="page">{guide.title}</li>
      </ol>
    </nav>
    <h1 id="guide-title">{guide.title}</h1>
    <p class="lede" data-guide-answer><GuideText parts={guide.answer} /></p>
    <div class="guide-visual">
      <GuideChart rows={rows} date={date} ordered={STEPS.includes(guide.slug)} />
      <ArtImage src={art.src} alt={art.alt} {...GUIDE_ART_IMAGE} loading="lazy" motion="none" class="guide-art" />
    </div>
  </div>
</section>

{
  guide.upcoming && (
    <section
      class="section section--lit"
      id={guide.upcoming.id}
      aria-labelledby={`${guide.upcoming.id}-title`}
      data-guide-upcoming
    >
      <div class="wrap stack">
        <GuideUpcoming upcoming={guide.upcoming} />
      </div>
    </section>
  )
}

<section
  class:list={["section", offset % 2 === 0 ? "section--lit" : "section--band"]}
  id="start"
  aria-labelledby="start-title"
  data-guide-start
>
  <div class="wrap stack">
    <h2 id="start-title">Five to start with</h2>
    <p class="meta">The first of each row above, A to Z. A listing is not a recommendation.</p>
    <div data-pagefind-ignore>
      <ul class="guide-list" data-guide-list>
        {start.map((item) => <GuideItem item={item} />)}
      </ul>
    </div>
    <p class="btn-row">
      <a class="btn btn--gold" href={browse}>See more in Startup Resources</a>
    </p>
  </div>
</section>

<section
  class:list={["section", offset % 2 === 0 ? "section--band" : "section--lit"]}
  aria-labelledby="more-title"
>
  <div class="wrap stack">
    <h2 id="more-title">More guides for founders</h2>
    <div class="more">
      {
        others.map((group) => (
          <div>
            <h3>{group.heading}</h3>
            <ul>
              {group.guides.map((g) => (
                <li>
                  <a class="tap-target" href={guidePath(g.slug)}>
                    {g.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p>Missing a Colorado resource? A person reviews every suggestion.</p>
    <p class="btn-row">
      <a class="btn btn--stone" href="/ecosystem-canvas/suggest/">Suggest a resource</a>
    </p>
  </div>
</section>

<style>
  /* The chart beside the guide's picture on a wide screen, the picture under
     it on a phone (L6's scenes, 2026-11-04). */
  .guide-visual {
    display: grid;
    gap: var(--s-5);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .guide-visual {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }
  :global(.guide-art) {
    width: min(100%, 40rem);
    border-radius: var(--r-card);
    box-shadow: var(--sh-glow);
  }
  /* The breadcrumb's look is the global .crumbs in global.css (#195). */
  .more ul {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
  }
  /* Nine guides read as three short columns, one per group, on a wide screen. */
  .more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--s-4) var(--s-5);
  }
  .more h3 {
    margin: 0 0 var(--s-2);
    font-size: var(--t-step-1);
  }
  .more ul {
    margin: 0;
  }
  .guide-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 0 var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }
  /* Where the closing buttons cannot share a line, each takes the full width. */
  @media (max-width: 32rem) {
    .btn-row .btn {
      flex: 1 1 100%;
    }
  }
</style>
