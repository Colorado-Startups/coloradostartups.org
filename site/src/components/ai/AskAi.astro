---
// The "Ask your AI" row (step A3a, 2026-11-15): Copy prompt and Open in
// Claude, both made from the page's subject (prompt.ts). Copy prompt comes
// first because it works in Claude, OpenCode and any open-weight model; the
// link is best effort. Only the AIs in 01_doctrine/ai_recommend.yaml are
// offered (Paul, 2026-11-16).
// The prompt sits in a box too, so a visitor without JavaScript, or whose
// browser refuses the copy, can select it by hand. The copy button stays
// hidden until the bundled script runs. Owner: A3a.
// Both actions count (step M1c): Open in Claude as connect_click, target
// "claude"; Copy prompt as connect_copy, target "prompt", or in the Ask
// dialog as ask_used, kind "copy". `where` is the page's path as a slug
// unless the caller names the band.
import { trackAttrs, whereOf } from "../../lib/track-attrs";
import { askAiLinks } from "./prompt";

interface Props {
  /** What the page is about: a guide's title or a region's name. */
  subject: string;
  /** The page's path, such as /guides/funding-programs/. */
  path: string;
  /** The question to ask; prompt.ts has the default. */
  question?: string;
  /** The heading's id, unique on the page. */
  id?: string;
  /**
   * A short row for a list of example asks (/connect/): the question is the
   * h3 heading, and the intro line and long note become one short note.
   */
  compact?: boolean;
  /** The band, as the click events' `where`; the page's path as a slug when omitted. */
  where?: string;
  /** The Ask dialog's copy of the row: Copy prompt counts as ask_used. */
  dialog?: boolean;
}

const { subject, path, question, id = "ask-ai", compact = false, dialog = false } = Astro.props;
const where = Astro.props.where ?? whereOf(path);
const copyAttrs = dialog
  ? trackAttrs("ask_used", { where, kind: "copy" })
  : trackAttrs("connect_copy", { where, target: "prompt" });
const claudeAttrs = trackAttrs("connect_click", { where, target: "claude" });
const { prompt, claude } = askAiLinks({ subject, path, question });
const field = `${id}-prompt`;
const COMPACT_NOTE = "In OpenCode or an open-weight model, paste the copied prompt.";
const NOTE = `Open in Claude fills the prompt in a new tab. ${COMPACT_NOTE}`;
---

<div class:list={["ask-ai", compact && "ask-ai--compact"]} data-ask-ai>
  {compact ? <h3 id={id}>{question}</h3> : <h2 id={id}>Ask your AI about this page</h2>}
  {
    !compact && (
      <p>
        The prompt tells your AI to look things up on our public MCP server, so its answer uses this site's listings.
      </p>
    )
  }
  <div class="btn-row">
    <button type="button" class="btn btn--gold" data-ask-copy hidden {...copyAttrs}>Copy prompt</button>
    <a class="btn btn--stone" href={claude} data-ask-claude target="_blank" rel="noopener" aria-describedby={`${id}-note`} {...claudeAttrs}>
      Open in Claude
    </a>
  </div>
  <p class="meta" role="status" data-ask-status></p>
  <p class="meta" id={`${id}-note`}>
    {compact ? COMPACT_NOTE : NOTE}
  </p>
  <details data-ask-details>
    <summary>See the prompt</summary>
    <label class="visually-hidden" for={field}>The prompt</label>
    <textarea id={field} readonly rows="5" data-ask-prompt>{prompt}</textarea>
  </details>
</div>

<script>
  // The row's behavior lives in ask-ai.ts, which the Ask dialog shares. The
  // dialog's copy sits in a <template>, so this loop never sees it.
  import { initAskAi } from "./ask-ai";

  for (const root of document.querySelectorAll<HTMLElement>("[data-ask-ai]")) initAskAi(root);
</script>

<style>
  .ask-ai h2,
  .ask-ai h3 {
    margin-top: 0;
  }
  .ask-ai .meta {
    margin: var(--s-3) 0 0;
  }
  .ask-ai details {
    margin-top: var(--s-4);
  }
  .ask-ai summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .ask-ai textarea {
    width: 100%;
    max-width: 60ch;
    font-size: var(--t-step--1);
    line-height: 1.5;
    resize: vertical;
  }
  /* .btn sets display, which beats the browser's own [hidden] rule. Without
     this line the copy button shows, and does nothing, before the script runs. */
  .ask-ai .btn[hidden] {
    display: none;
  }
</style>
