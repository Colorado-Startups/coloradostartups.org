---
// The statewide map: Colorado with Photon Mountain, Fusion Canyon and Space
// Peak outlined. Two layers in one fixed-ratio box, so nothing shifts:
//   1. a drawing made at build time (lib/regions/colorado-map.ts): the whole
//      map with no JavaScript, and what shows before the live map loads;
//   2. the live map (colorado-map.client.ts): MapLibre over OpenFreeMap,
//      loaded when the figure nears the screen. It hides the drawing once it
//      has drawn.
// Zones come from data/geo/regions.geojson: each is the loop its named roads
// close, traced along US Census road lines. The region chips or links beside
// the map are its list alternative.
//
// `zone` zooms both layers to one region and dims the other two: the drawing
// at build time, the live map when it fits to the zone's bounds.
//
// `live` (default true) marks the figure for the live map. The loader itself
// is <LiveMaps /> (LiveMaps.astro), which a page adds once: MapLibre is far
// past a page's 75 KB JavaScript goal, so a page that shows only the drawing,
// such as the home page, ships none of it.
import type { RegionId } from "@cs/shared";

import { ZONES, zoneById } from "../../lib/regions/colorado-geo";
import { coloradoMapSvg, MAP_HEIGHT, MAP_WIDTH } from "../../lib/regions/colorado-map";
import { andList } from "../../lib/text";

interface Props {
  /** Unique on the page. */
  id: string;
  /** Zoom to one region and dim the other two. Omit for the whole state. */
  zone?: RegionId;
  /** Accessible name for the map. */
  label?: string;
  /** One short line under the map; empty for none. */
  caption?: string;
  /** Load the live map over the drawing (the page must also render <LiveMaps />). */
  live?: boolean;
}

const { id, zone, live = true } = Astro.props;
const focus = zone ? zoneById(zone).properties : undefined;
const {
  label = focus
    ? `Map of ${focus.name}, one of the three Colorado Startups regions`
    : "Map of Colorado with the three Colorado Startups regions outlined",
  caption = focus ? `${focus.name} on the Front Range.` : "Photon Mountain, Fusion Canyon and Space Peak along the Front Range.",
} = Astro.props;
const description = focus
  ? `${focus.name} covers ${andList(focus.cities)}. The other two regions are dimmed.`
  : ZONES.features.map((z) => `${z.properties.name} covers ${andList(z.properties.cities)}.`).join(" ");
const svg = coloradoMapSvg({ label, description }, { zone });
---

<figure
  class="colorado-map"
  id={id}
  data-colorado-map={live ? "" : undefined}
  data-zone={zone}
  style={`--map-ratio: ${MAP_WIDTH} / ${MAP_HEIGHT}`}
>
  <div class="colorado-map__box">
    <div class="colorado-map__drawing" set:html={svg} />
    {live && <div class="colorado-map__live" data-map-canvas data-label={label} />}
  </div>
  <p class="colorado-map__desc visually-hidden">{description}</p>
  <figcaption>
    {caption && <span>{caption}</span>}
    <small>
      Each line follows named roads, from US Census road data. A proposal, not a legal line.{live && " Basemap © OpenMapTiles, data © OpenStreetMap contributors."}
    </small>
  </figcaption>
</figure>

<style>
  .colorado-map {
    margin: 0;
  }
  .colorado-map__box {
    position: relative;
    aspect-ratio: var(--map-ratio);
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--c-surface);
    box-shadow: 0 0 0 var(--line-hair) var(--c-border);
  }
  .colorado-map__drawing,
  .colorado-map__live {
    position: absolute;
    inset: 0;
  }
  .colorado-map__drawing :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .colorado-map.is-live .colorado-map__drawing {
    visibility: hidden;
  }
  /* The drawing carries the description until the live map hides it; then this does. */
  .colorado-map:not(.is-live) .colorado-map__desc {
    display: none;
  }
  figcaption {
    display: grid;
    gap: var(--s-1);
    margin-top: var(--s-2);
    color: var(--c-text-dim);
  }
  figcaption small {
    font-size: var(--t-step--1);
  }
  :global(.colorado-map__label) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-step-0);
    color: var(--c-text);
    text-shadow:
      0 0 4px var(--c-ground),
      0 0 2px var(--c-ground);
    white-space: nowrap;
    pointer-events: none;
  }
</style>
