---
// The statewide map: Colorado with Photon Mountain, Fusion Canyon and Space
// Peak outlined. Two layers in one fixed-ratio box, so nothing shifts:
//   1. a drawing made at build time (lib/regions/colorado-map.ts): the whole
//      map with no JavaScript, and what shows before the live map loads;
//   2. the live map (colorado-map.client.ts): MapLibre over OpenFreeMap,
//      loaded when the figure nears the screen. It hides the drawing once it
//      has drawn.
// Zones come from data/geo/regions.geojson (US Census places). The region
// cards beside the map are its list alternative.
import { coloradoMapSvg, MAP_HEIGHT, MAP_WIDTH } from "../../lib/regions/colorado-map";

interface Props {
  /** Unique on the page. */
  id: string;
  /** Accessible name for the map. */
  label?: string;
  /** One short line under the map. */
  caption?: string;
}

const {
  id,
  label = "Map of Colorado with the three Colorado Startups regions outlined",
  caption = "Photon Mountain, Fusion Canyon and Space Peak along the Front Range.",
} = Astro.props;
const description =
  "Photon Mountain covers Boulder, Golden, Arvada and Denver. Fusion Canyon covers Fort Collins, Loveland, Windsor and Greeley. Space Peak covers Colorado Springs.";
const svg = coloradoMapSvg({ label, description });
---

<figure class="colorado-map" id={id} data-colorado-map style={`--map-ratio: ${MAP_WIDTH} / ${MAP_HEIGHT}`}>
  <div class="colorado-map__box">
    <div class="colorado-map__drawing" set:html={svg} />
    <div class="colorado-map__live" data-map-canvas data-label={label}></div>
  </div>
  <figcaption>
    <span>{caption}</span>
    <small>Zones from US Census places, a proposal, not a legal line. Basemap © OpenMapTiles, data © OpenStreetMap contributors.</small>
  </figcaption>
</figure>

<script>
  import { mountColoradoMaps } from "./colorado-map.client";
  mountColoradoMaps();
</script>

<style>
  .colorado-map {
    margin: 0;
  }
  .colorado-map__box {
    position: relative;
    aspect-ratio: var(--map-ratio);
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--c-surface);
    box-shadow: 0 0 0 var(--line-hair) var(--c-border);
  }
  .colorado-map__drawing,
  .colorado-map__live {
    position: absolute;
    inset: 0;
  }
  .colorado-map__drawing :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .colorado-map.is-live .colorado-map__drawing {
    visibility: hidden;
  }
  figcaption {
    display: grid;
    gap: var(--s-1);
    margin-top: var(--s-2);
    color: var(--c-text-dim);
  }
  figcaption small {
    font-size: var(--t-step--1);
  }
  :global(.colorado-map__label) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-step-0);
    color: var(--c-text);
    text-shadow:
      0 0 4px var(--c-ground),
      0 0 2px var(--c-ground);
    white-space: nowrap;
    pointer-events: none;
  }
</style>
