---
// The map: Colorado with Photon Mountain, Fusion Canyon and Space Peak drawn
// along their roads. Three layers in one fixed-ratio box, so nothing shifts:
//   1. a shaded-relief image of the frame (USGS 3DEP; scripts/geo/views.mjs),
//      lazy-loaded, tinted by the box's own colors;
//   2. a drawing made at build time (lib/regions/colorado-map.ts): the roads,
//      zones, cities and names, with no JavaScript;
//   3. the live map (colorado-map.client.ts): MapLibre over OpenFreeMap,
//      loaded when a visitor presses "Explore the live map", the button under
//      the box. It hides the first two once it has drawn.
// Zones come from data/geo/regions.geojson: each is the loop its named roads
// close, traced along US Census road lines. The region chips or links beside
// the map are its list alternative.
//
// `zone` zooms every layer to one region.
//
// `priority` marks the map as the page's first-screen image (a region page,
// since R1): its relief loads eagerly at high fetch priority, as a hero
// painting did. Everywhere else the relief waits (loading="lazy").
//
// `variant="thumb"` is a card header: the zone at 16:9 with a state locator,
// as one link to the region's page. It has no caption and no live map.
//
// `live` (default true) marks the figure for the live map. The loader itself
// is <LiveMaps /> (LiveMaps.astro), which a page adds once: MapLibre is far
// past a page's 75 KB JavaScript goal, so a page that shows only the drawing,
// such as the home page, ships none of it. There, each zone is a link.
//
// `zones` (the statewide drawing only) makes each zone the entrance to its
// region (step W2): a focusable link that lifts and glows on hover, keyboard
// focus and tap. Keyboard focus also opens a card in the map's top left
// corner with the region's crest, name and three counts (zone-counts.ts).
// Hover does not open it: the corner is away from the zone, so a pointer could
// not move onto the card without it closing (WCAG 1.4.13), and a card beside
// each zone could cover a neighbouring zone's link. The card is aria-hidden:
// the page lists the same counts beside the map, so it adds nothing a phone,
// a pointer or a screen reader would miss. A page that passes `zones` sets
// data-dismissed on the figure to close the card with Escape
// (home/sections/Where.astro).
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import type { RegionId } from "@cs/shared";

import { ZONES, zoneById, type LonLat } from "../../lib/regions/colorado-geo";
import { coloradoMapSvg, viewOf } from "../../lib/regions/colorado-map";
import { inFrame } from "../../lib/regions/colorado-views";
import { REGION_COLORS } from "../../lib/regions/map";
import { andList } from "../../lib/text";
import { brandArt } from "../art/art-assets";
import { regionCrestKey } from "../art/keepers";
import { COUNT_LABELS, type ZoneCounts } from "./zone-counts";

interface Props {
  /** Unique on the page. */
  id: string;
  /** Zoom to one region. Omit for the whole state. */
  zone?: RegionId;
  /** "thumb": a 16:9 card header that links to the region's page. Needs `zone`. */
  variant?: "full" | "thumb";
  /** Accessible name for the map. */
  label?: string;
  /** One short line under the map; empty for none. */
  caption?: string;
  /** Load the live map over the drawing (the page must also render <LiveMaps />). */
  live?: boolean;
  /** How wide the map draws, for the relief image's `sizes`. */
  sizes?: string;
  /** Each zone's counts: makes the statewide zones focusable, with a card each. */
  zones?: readonly ZoneCounts[];
  /** The first-screen image: load the relief eagerly, at high fetch priority. */
  priority?: boolean;
}

const { id, zone, variant = "full", sizes, zones, priority = false } = Astro.props;
const thumb = variant === "thumb" && Boolean(zone);
const live = !thumb && (Astro.props.live ?? true);
const focus = zone ? zoneById(zone).properties : undefined;
const {
  label = focus
    ? `Map of ${focus.name}, one of the three Colorado Startups regions`
    : "Map of Colorado with the three Colorado Startups regions outlined",
  caption = focus ? `${focus.name} on the Front Range.` : "Photon Mountain, Fusion Canyon and Space Peak along the Front Range.",
} = Astro.props;
const description = focus
  ? `${focus.name} covers ${andList(focus.cities)}. Its line follows ${andList(focus.roads)}.`
  : ZONES.features.map((z) => `${z.properties.name} covers ${andList(z.properties.cities)}.`).join(" ");
const view = viewOf({ zone, variant });
const svg = coloradoMapSvg({ label, description }, { zone, variant });

const reliefs = import.meta.glob<{ default: ImageMetadata }>("../../assets/maps/relief-*.jpg", { eager: true });
const relief = reliefs[`../../assets/maps/relief-${view.id}.jpg`]?.default;
if (!relief) throw new Error(`site/src/assets/maps/relief-${view.id}.jpg is missing; run node scripts/geo/views.mjs`);
const ratio = `--map-ratio: ${view.frame.width} / ${view.frame.height}`;

// On the statewide drawing each zone is small, so a 56 px link sits over it.
// The region links beside the map say the same, so these stay out of the tab
// order and the accessibility tree.
const hits = zone
  ? []
  : ZONES.features.map((z) => {
      const ring = z.geometry.coordinates[0]!;
      const centre: LonLat = [ring.reduce((s, p) => s + p[0], 0) / ring.length, ring.reduce((s, p) => s + p[1], 0) / ring.length];
      const [x, y] = inFrame(view.frame, centre);
      const counts = zones?.find((c) => c.id === z.id);
      const crest = counts ? brandArt(regionCrestKey(z.id)) : undefined;
      if (counts && !crest) throw new Error(`no crest for region "${z.id}"; add it to brand.lock.json`);
      return {
        id: z.id,
        name: z.properties.name,
        style: `left: ${(x * 100).toFixed(2)}%; top: ${(y * 100).toFixed(2)}%; --region-color: ${REGION_COLORS[z.id]}`,
        counts,
        crest,
      };
    });
---

{
  thumb ? (
    <a class="colorado-map colorado-map--thumb" id={id} href={`/regions/${zone}/`} data-zone={zone} style={ratio}>
      <span class="colorado-map__box">
        <Image
          class="colorado-map__relief"
          src={relief}
          widths={[368, 736]}
          sizes={sizes ?? "(max-width: 760px) calc(100vw - 48px), 380px"}
          format="webp"
          quality={55}
          alt=""
          loading="lazy"
        />
        <span class="colorado-map__drawing" set:html={svg} />
      </span>
    </a>
  ) : (
    <figure class="colorado-map" id={id} data-colorado-map={live ? "" : undefined} data-zone={zone} style={ratio}>
      <div class="colorado-map__box">
        <Image
          class="colorado-map__relief"
          src={relief}
          widths={[640, 960, 1280]}
          sizes={sizes ?? "(max-width: 760px) calc(100vw - 48px), 640px"}
          format="webp"
          quality={55}
          alt=""
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : undefined}
        />
        <div class="colorado-map__drawing" set:html={svg} />
        {hits.map((h) =>
          h.counts && h.crest ? (
            <>
              <a class="colorado-map__hit colorado-map__hit--zone" href={`/regions/${h.id}/`} style={h.style} data-zone={h.id} aria-label={`${h.name} on the map`} />
              <div class="colorado-map__card" data-zone={h.id} style={`--region-color: ${REGION_COLORS[h.id]}`} aria-hidden="true">
                <img class="colorado-map__crest" src={h.crest.src} srcset={h.crest.srcset} sizes="56px" width="56" height="56" alt="" loading="lazy" decoding="async" />
                <p class="colorado-map__card-name">{h.name}</p>
                <dl class="colorado-map__counts">
                  {COUNT_LABELS.map(([key, label]) => (
                    <div data-count={key}>
                      <dt>{label}</dt>
                      <dd>{h.counts![key]}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </>
          ) : (
            <a class="colorado-map__hit" href={`/regions/${h.id}/`} style={h.style} tabindex="-1" aria-hidden="true" title={h.name} />
          ),
        )}
        {live && <div class="colorado-map__live" data-map-canvas data-label={label} />}
      </div>
      {/* Under the drawing, never over it: in a corner the button covered the names beneath it on a phone.
          The loader shows it, and only where the browser can draw the live map. The row keeps its height either way, so nothing below moves. */}
      {live && (
        <p class="colorado-map__actions">
          <button type="button" class="colorado-map__open" data-map-open hidden>
            Explore the live map
          </button>
        </p>
      )}
      <p class="colorado-map__desc visually-hidden">{description}</p>
      <figcaption>
        {caption && <span>{caption}</span>}
        <small>
          Each line follows named roads. A proposal, not a legal line. Roads: US Census Bureau. Relief: USGS.{live && " Basemap © OpenMapTiles, data © OpenStreetMap contributors."}
        </small>
      </figcaption>
    </figure>
  )
}

<style>
  .colorado-map {
    display: block;
    margin: 0;
  }
  .colorado-map__box {
    display: block;
    position: relative;
    aspect-ratio: var(--map-ratio);
    border-radius: var(--r-card);
    overflow: hidden;
    /* Mountains west, plains east: a cool-to-warm wash that the relief shades. */
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--c-community) 46%, var(--c-surface)) 0%,
      color-mix(in oklab, var(--c-community) 14%, var(--c-surface)) 46%,
      color-mix(in oklab, var(--c-accent) 34%, var(--c-surface)) 100%
    );
    box-shadow: 0 0 0 var(--line-hair) var(--c-border);
    isolation: isolate;
  }
  .colorado-map--thumb .colorado-map__box {
    border-radius: 0;
    box-shadow: none;
  }
  /* A thumbnail fills the top of a card that clips its overflow, so the focus
     ring draws inside the link's own box, where nothing cuts it. */
  .colorado-map--thumb:focus-visible {
    outline-offset: calc(-1 * var(--line-bold));
  }
  .colorado-map__relief,
  .colorado-map__drawing,
  .colorado-map__live {
    position: absolute;
    inset: 0;
  }
  /* The relief is mid grey with lit and shaded slopes: overlaid on the wash, it
     lightens one side of a ridge and darkens the other, in either theme. */
  .colorado-map__relief {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: overlay;
    filter: contrast(1.35) brightness(0.86);
  }
  .colorado-map__drawing {
    display: block;
  }
  .colorado-map__drawing :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Until the live map loads, its empty layer must not take the drawing's clicks. */
  .colorado-map:not(.is-live) .colorado-map__live {
    pointer-events: none;
  }
  .colorado-map__actions {
    display: flex;
    justify-content: flex-end;
    min-height: var(--size-tap);
    margin: var(--s-2) 0 0;
  }
  .colorado-map__open {
    min-height: var(--size-tap);
    padding-inline: var(--s-3);
    border: var(--line-hair) solid var(--c-border);
    border-radius: var(--r-chisel);
    background: var(--c-ground);
    color: var(--c-text);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .colorado-map__open:hover {
    background: var(--c-surface);
  }
  .colorado-map__hit {
    position: absolute;
    width: 56px;
    height: 56px;
    margin: -28px 0 0 -28px;
    border-radius: 50%;
  }
  .colorado-map__hit:hover {
    box-shadow: 0 0 0 2px var(--c-text);
  }

  /* A zone as the entrance to its region: a ring in its color marks it, and
     interest lifts it and makes it glow. Tap counts too (:active). */
  .colorado-map__hit--zone {
    z-index: 1;
    box-shadow:
      0 0 0 var(--line-edge) color-mix(in oklab, var(--region-color) 70%, transparent),
      inset 0 0 0 var(--line-edge) color-mix(in oklab, var(--c-ground) 60%, transparent);
  }
  .colorado-map__hit--zone:is(:hover, :focus-visible, :active) {
    z-index: 2;
    scale: 1.18;
    background: color-mix(in oklab, var(--region-color) 24%, transparent);
    box-shadow:
      0 0 0 var(--line-bold) var(--region-color),
      0 0 22px 8px color-mix(in oklab, var(--region-color) 55%, transparent);
  }
  .colorado-map__card {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    z-index: 3;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s-2) var(--s-3);
    width: min(16rem, calc(100% - 2 * var(--s-3)));
    padding: var(--s-3);
    border-left: var(--line-bold) solid var(--region-color);
    border-radius: var(--r-card);
    background: var(--c-ground);
    box-shadow:
      0 0 0 var(--line-hair) var(--c-border),
      var(--sh-glow);
    color: var(--c-text);
    pointer-events: auto;
    visibility: hidden;
    opacity: 0;
  }
  /* Keyboard focus only; see the note at the top of this file. */
  .colorado-map__hit--zone:focus-visible + .colorado-map__card {
    visibility: visible;
    opacity: 1;
  }
  /* Escape closes the card until the pointer or focus moves on (Where.astro). */
  .colorado-map[data-dismissed] .colorado-map__card {
    visibility: hidden;
    opacity: 0;
  }
  .colorado-map__crest {
    width: 56px;
    height: 56px;
  }
  .colorado-map__card-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-step-1);
    line-height: 1.15;
  }
  .colorado-map__counts {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-2);
    margin: 0;
  }
  .colorado-map__counts div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }
  .colorado-map__counts dt {
    color: var(--c-text-dim);
    font-size: var(--t-step--1);
    line-height: 1.2;
  }
  .colorado-map__counts dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--t-step-2);
    line-height: 1.1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .colorado-map__hit--zone {
      transition:
        scale 180ms ease-out,
        box-shadow 180ms ease-out,
        background-color 180ms ease-out;
    }
    .colorado-map__card {
      translate: 0 -6px;
      transition:
        opacity 160ms ease-out,
        translate 200ms ease-out,
        visibility 0s linear 200ms;
    }
    .colorado-map__hit--zone:focus-visible + .colorado-map__card {
      translate: 0 0;
      transition:
        opacity 160ms ease-out,
        translate 200ms ease-out,
        visibility 0s;
    }
  }
  .colorado-map--thumb:hover .colorado-map__drawing,
  .colorado-map--thumb:focus-visible .colorado-map__drawing {
    filter: brightness(1.06) saturate(1.2);
  }
  .colorado-map.is-live .colorado-map__drawing,
  .colorado-map.is-live .colorado-map__relief,
  .colorado-map.is-live .colorado-map__hit,
  .colorado-map.is-live .colorado-map__card {
    visibility: hidden;
  }
  /* The drawing carries the description until the live map hides it; then this does. */
  .colorado-map:not(.is-live) .colorado-map__desc {
    display: none;
  }
  figcaption {
    display: grid;
    gap: var(--s-1);
    margin-top: var(--s-2);
    color: var(--c-text-dim);
  }
  figcaption small {
    font-size: var(--t-step--1);
  }
  :global(.colorado-map__label) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-step-0);
    color: var(--c-text);
    text-shadow:
      0 0 4px var(--c-ground),
      0 0 2px var(--c-ground);
    white-space: nowrap;
    pointer-events: none;
  }
</style>
