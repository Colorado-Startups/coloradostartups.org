---
// The live map loader. A page that shows a live ColoradoMap renders this once.
// It arms each map's "Explore the live map" button (colorado-map.client.ts);
// MapLibre loads only when a visitor presses one. A page without this ships
// none of MapLibre, and its maps stay drawings.
---

<script>
  import { mountColoradoMaps } from "./colorado-map.client";
  mountColoradoMaps();
</script>
