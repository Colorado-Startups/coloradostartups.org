---
// A keeper's portrait: Communitas, Resourcus or Publicus, all three AI agents.
// Files live at src/assets/art/agents/<id>.webp (large, half body, 4:5) and
// <id>-small.webp (head and shoulders, 1:1), matching Wave 0b's
// `portrait: agents/<id>` field in data/team/dwarves.yaml. Each size shows its
// own file; with none, it shows a placeholder in the keeper's color.
// test/unit/l7/art-components.test.ts checks both files exist for every keeper.
// Idle motion: the lantern glow flickers on both sizes, and embers rise on the
// large one; both stop under prefers-reduced-motion.
// Use portraitAlt() from ./keepers for alt text that says it is an AI agent.
// The large portrait goes inside L12's Frame (for example shape="arch"
// ratio="4 / 5"): pass `framed`, and the portrait renders a plain
// .hall-frame__art box while the Frame draws the bevel. Owned by L7; see
// art/DIRECTION.md.
import { Image } from "astro:assets";
import { findArt, fitWidths } from "./art-assets";
import { EMBERS, emberStyle } from "./embers";
import { KEEPERS, portraitKeys, type KeeperId } from "./keepers";
import "./idle-motion.css";

interface Props {
  id: KeeperId;
  /** Describe the keeper; portraitAlt() writes one. Pass "" only beside the keeper's name. */
  alt: string;
  size?: "small" | "large";
  /** CSS sizes for the srcset. Defaults suit a 96 px avatar and a 480 px card. */
  sizes?: string;
  /** srcset widths. Defaults suit those sizes; pass narrower ones for a smaller slot. */
  widths?: number[];
  /** Set inside L12's <Frame>: render a plain .hall-frame__art box, not a <figure>. */
  framed?: boolean;
  /** "eager" for a portrait in the first screen, with a high fetch priority, as ArtImage does. */
  loading?: "eager" | "lazy";
}

const { id, alt, size = "large", sizes, widths: widthsProp, framed = false, loading = "lazy" } = Astro.props;

const keeper = KEEPERS[id];
const keys = portraitKeys(id);
const art = findArt(size === "small" ? keys.small : keys.large);
const widths = widthsProp ?? (size === "small" ? [96, 160, 320] : [480, 720, 960]);
// The sizes attribute cannot read CSS variables, so it uses rem: 6rem is the
// 96 px avatar, 30rem the 480 px card, 40rem the 640 px breakpoint.
const defaultSizes = size === "small" ? "6rem" : "(max-width: 40rem) 90vw, 30rem";
const initial = id.charAt(0).toUpperCase();
const style = `--anchor:${keeper.anchor};--glow-x:${keeper.glow.x};--glow-y:${keeper.glow.y}`;
// A Frame is already the <figure>; inside one, this is just the picture box.
const Root = framed ? "div" : "figure";
---

<Root
  class:list={["art-frame", "portrait", framed ? "portrait--framed hall-frame__art" : `portrait--${size}`]}
  style={style}
  data-portrait={id}
>
  {
    art ? (
      <Image
        src={art}
        alt={alt}
        widths={fitWidths(widths, art.width)}
        sizes={sizes ?? defaultSizes}
        loading={loading}
        fetchpriority={loading === "eager" ? "high" : "auto"}
      />
    ) : alt ? (
      <div class="portrait-placeholder" role="img" aria-label={`${alt} Portrait in progress.`}>
        <span aria-hidden="true">{initial}</span>
      </div>
    ) : (
      <div class="portrait-placeholder" aria-hidden="true">
        <span>{initial}</span>
      </div>
    )
  }
  {size === "large" && <span class="art-glow" aria-hidden="true" />}
  {
    size === "large" && (
      <span class="art-embers" aria-hidden="true">
        {EMBERS.slice(0, 4).map((e) => (
          <i style={emberStyle(e)} />
        ))}
      </span>
    )
  }
  {size === "small" && <span class="portrait-halo" aria-hidden="true" />}
</Root>

<style>
  .portrait {
    margin: 0;
    background: var(--c-surface-2);
    container-type: inline-size;
  }
  /* A default size, so a small portrait never collapses in a flex row.
     Set --portrait-small on a parent to change it. */
  .portrait--small {
    width: var(--portrait-small, var(--s-9));
    flex: none;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: visible;
    box-shadow: 0 0 0 var(--line-bold) var(--c-accent);
  }
  /* Inside a Frame, hall.css owns the edge, the arch and the ring; this only
     keeps a ratio when the Frame sets none. */
  .portrait--framed {
    aspect-ratio: var(--frame-ratio, 4 / 5);
  }
  /* hall.css rings every img in a Frame; the box already carries that ring. */
  .portrait--framed :global(img) {
    box-shadow: none;
  }
  .portrait :global(img),
  .portrait-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }
  .portrait-placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(70% 70% at var(--glow-x) var(--glow-y), color-mix(in oklab, var(--c-accent) 55%, transparent), transparent 70%),
      linear-gradient(160deg, var(--c-surface), var(--c-surface-2));
    box-shadow: inset 0 0 0 var(--s-1) var(--anchor);
    color: var(--c-text);
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1rem, 30cqi, 4rem);
  }
  /* The small portrait's idle motion: a lantern halo just outside the ring. */
  .portrait-halo {
    position: absolute;
    inset: calc(-1 * var(--line-bold));
    border-radius: 50%;
    pointer-events: none;
    box-shadow: 0 0 var(--s-3) var(--line-bold) color-mix(in oklab, var(--c-accent) 55%, transparent);
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: no-preference) {
    .portrait-halo {
      animation: art-flicker 2.4s ease-in-out 2 forwards;
    }
  }
</style>
