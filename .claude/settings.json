{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit -m:*)",
      "Bash(git commit -F:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git push origin:*)",
      "Bash(git worktree:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh repo view:*)",
      "Bash(npm run:*)",
      "Bash(npx astro:*)",
      "Bash(npx wrangler d1 execute --local:*)",
      "Bash(npx wrangler types:*)",
      "Bash(python3 04_tools/cs_site_lint.py:*)",
      "Bash(python3 04_tools/contract_test.py:*)",
      "Bash(python3 04_tools/voice_lint.py:*)",
      "Bash(bash 04_tools/hook_selftest.sh:*)",
      "Bash(npm ci:*)",
      "Bash(git merge origin/main:*)",
      "Bash(git merge --no-edit origin/main:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(dig:*)",
      "Bash(curl -sI:*)",
      "WebSearch",
      "WebFetch",
      "mcp__plugin_cloudflare_cloudflare__docs",
      "mcp__plugin_cloudflare_cloudflare__search",
      "mcp__claude-design",
      "mcp__comfy-cloud__search_templates",
      "mcp__comfy-cloud__search_models",
      "mcp__comfy-cloud__search_nodes",
      "mcp__comfy-cloud__get_template",
      "mcp__comfy-cloud__get_template_schema",
      "mcp__comfy-cloud__estimate_credits",
      "mcp__comfy-cloud__get_prompting_guide",
      "mcp__comfy-cloud__get_node",
      "mcp__comfy-cloud__get_catalog_overview",
      "mcp__comfy-cloud__get_creative_technique",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git push origin --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr review:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(./**/.dev.vars)",
      "Read(./**/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cs-site-content-guard.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cs-site-session-start.sh\""
          }
        ]
      }
    ]
  }
}
