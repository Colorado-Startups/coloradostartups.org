{
  // Communitas: the Colorado Startups Slack app. Owner: L5.
  //
  // Public workers.dev URL on purpose: Slack must reach /slack/events, and Slack
  // cannot pass Cloudflare Access. The auth is Slack's request signature
  // (SLACK_SIGNING_SECRET), checked by slack-cloudflare-workers on every request.
  //
  // Ships PAUSED. The weekly cron fires as soon as this deploys, so
  // COMMUNITAS_PAUSED stays "true" until Paul flips it after the test-workspace
  // checks (plan, Wave 3 step 8).
  //
  // Answers come from Resourcus through a service binding to the site Worker's
  // ResourcusRPC entrypoint. That path has no public URL.
  //
  // Secrets (wrangler secret put, never here): SLACK_SIGNING_SECRET,
  // SLACK_BOT_TOKEN, USER_KEY_SALT.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cs-communitas",
  // The Colorado Startups account (see site/wrangler.jsonc).
  "account_id": "437b80fdd39fee1c4daab6da32fa5aeb",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "services": [{ "binding": "RESOURCUS", "service": "coloradostartups-site", "entrypoint": "ResourcusRPC" }],
  "ratelimits": [
    // Per Slack user: 10 questions per 60 s. Fails open; the site's budget guard is the spending stop.
    { "name": "SLACK_ASK_LIMIT", "namespace_id": "3401", "simple": { "limit": 10, "period": 60 } }
  ],
  // Mondays, Wednesdays and Fridays at 15:00 UTC: 9:00 MDT in summer, 8:00 MST in winter. Cron runs in UTC only.
  "triggers": { "crons": ["0 15 * * 1,3,5"] },
  "vars": { "COMMUNITAS_PAUSED": "true", "SITE_ORIGIN": "https://coloradostartups.org" },
  "env": {
    "staging": {
      "name": "cs-communitas-staging",
      "workers_dev": true,
      "services": [
        { "binding": "RESOURCUS", "service": "coloradostartups-site-staging", "entrypoint": "ResourcusRPC" }
      ],
      "ratelimits": [
        { "name": "SLACK_ASK_LIMIT", "namespace_id": "3402", "simple": { "limit": 10, "period": 60 } }
      ],
      "triggers": { "crons": ["0 15 * * 1,3,5"] },
      "vars": { "COMMUNITAS_PAUSED": "true", "SITE_ORIGIN": "https://coloradostartups-site-staging.coloradostartups.workers.dev" }
    }
  }
}
